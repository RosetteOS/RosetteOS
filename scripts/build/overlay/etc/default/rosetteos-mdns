# /etc/default/rosetteos-mdns
# Configuration for RosetteOS Multicast DNS (mDNS) Responder Daemon

ENABLED="yes"
HOSTNAME="rosetteos"
MDNS_DOMAIN="local"

# Enabled service advertisements (comma-separated):
#   http       - Mainsail / Fluidd Web UI via Nginx (port 80)
#   ssh        - Dropbear SSH shell console (port 22)
#   octoprint  - OctoPrint API emulation (port 80)
#   moonraker  - Moonraker API service (port 7125)
SERVICES="http,ssh,octoprint,moonraker"

HTTP_PORT=80
SSH_PORT=22
MOONRAKER_PORT=7125
OCTOPRINT_PORT=80

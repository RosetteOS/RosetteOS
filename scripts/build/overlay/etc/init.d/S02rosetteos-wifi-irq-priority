#!/bin/sh
#
# Bounded, one-shot RT priority fix for a real, live-found IRQ contention
# issue (NebulaOS WiFi/camera IRQ contention mission, 2026-08-03): the USB
# controller's own IRQ thread (dwc2, servicing the UVC webcam) and the WiFi
# SDIO controller's own IRQ thread (mmc1, servicing wlan0) both default to
# the same SCHED_FIFO priority 50 under this kernel's threaded IRQs. The dwc2
# thread fires an extremely high, already-documented interrupt rate
# (~8000/sec USB start-of-frame interrupts, tied to VIDIOC_STREAMON being
# active at all - not the configured camera resolution or fps) whenever the
# webcam is streaming. At equal RT priority on this 2-core SoC, that
# constant interrupt storm was found to delay the WiFi IRQ thread from
# being serviced promptly, causing real, measured WiFi throughput
# bursts/stalls and a rising 802.11 tx-failure count specifically while the
# webcam stream was active - the underlying cause of a live-reported choppy
# webcam stream.
#
# Live-verified fix: raise the WiFi SDIO IRQ thread's priority above the
# USB controller's (50 -> 60). Confirmed across repeated trials to sharply
# reduce both full stream stalls and the tx-failure growth rate, with zero
# measurable impact on the Klipper<->MCU serial link (a separate IRQ,
# already at a much lower interrupt rate, whose retransmit counters stayed
# completely static throughout testing).
#
# Explicitly NOT done, and why:
#   - CPU-pinning the two IRQ threads to separate cores was also tried and
#     found to make things WORSE (more stalls, faster tx-failure growth) -
#     it removes scheduling flexibility the threads were actually
#     benefiting from. Left both threads free to run on either core
#     (the kernel default).
#   - No other IRQ thread's priority is touched here. The only other
#     plausible candidate checked (the Klipper<->MCU uart1 IRQ) showed no
#     evidence of being affected by the dwc2 storm even at the shared
#     default priority - raising priorities without evidence of a real
#     problem just recreates the same flat-priority contention at a higher
#     tier.
#
# Targets the WiFi SDIO IRQ thread(s) by NAME pattern (irq/44-mmc1 and
# irq/44-s-mmc1, as named live on this hardware), not by a hardcoded PID -
# PIDs are not stable across boots. These threads are created by the
# kernel during driver probe, well before any init.d script runs, so they
# are expected to already exist by the time this script runs; the small
# retry loop below is belt-and-suspenders only, not a real dependency wait.
#
# Runs once per boot (plain init.d "start" action - there is nothing to
# undo on "stop", the thread's priority reverts to the kernel default
# automatically next boot regardless).

RETRIES=5
DELAY=1

find_mmc1_irq_pids() {
	# Kernel threads appear in BusyBox ps's default output wrapped in
	# brackets (e.g. "[irq/44-mmc1]"), unlike plain userspace command
	# lines - match with an optional trailing "]" so this doesn't
	# silently stop matching if that formatting ever changes.
	ps 2>/dev/null | awk '
		$0 ~ /irq\/[0-9]+-(s-)?mmc1\]?$/ { print $1 }
	'
}

start() {
	if ! command -v chrt >/dev/null 2>&1; then
		echo "S02rosetteos-wifi-irq-priority: chrt not available, skipping" >&2
		return 0
	fi

	i=0
	pids=""
	while [ "$i" -lt "$RETRIES" ]; do
		pids=$(find_mmc1_irq_pids)
		[ -n "$pids" ] && break
		i=$((i + 1))
		sleep "$DELAY"
	done

	if [ -z "$pids" ]; then
		echo "S02rosetteos-wifi-irq-priority: no mmc1 IRQ thread found after $((RETRIES * DELAY))s - nothing to do, WiFi may not be present on this build" >&2
		return 0
	fi

	ok=1
	for pid in $pids; do
		if chrt -f -p 60 "$pid" 2>/dev/null; then
			echo "S02rosetteos-wifi-irq-priority: raised pid $pid (mmc1 IRQ thread) to SCHED_FIFO 60"
		else
			echo "S02rosetteos-wifi-irq-priority: failed to raise pid $pid - left at default priority" >&2
			ok=0
		fi
	done

	[ "$ok" = "1" ] || return 0
	return 0
}

case "$1" in
	start)
		start
		;;
	stop|restart)
		: # nothing to stop - one-shot priority bump, reverts naturally on reboot
		;;
	*)
		echo "Usage: $0 {start|stop|restart}"
		exit 1
		;;
esac

exit 0

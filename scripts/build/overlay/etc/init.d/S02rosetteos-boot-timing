#!/bin/sh
#
# NebulaOS boot-timing collector (pre-qualification mission Phase A9,
# 2026-07-31 - see docs/NEBULAOS_CAMERA_USB_RT_SOURCE_ANALYSIS.md sec 15/
# 18.18 Stage B for why this exists: "use device-local timestamps when
# possible... do not rely solely on remote host scans, which previously
# produced false positives during DHCP churn" - a real, already-learned
# lesson from earlier boot-timing work in this project).
#
# Backgrounded, bounded, one-shot: records /proc/uptime (a monotonic,
# kernel-relative clock, immune to any NTP-not-yet-synced concern) at
# each of several boot milestones as they're actually observed, via
# bounded polling - never blocks boot itself. Writes to a tmpfs log
# (fresh every boot by construction, never grows unbounded across
# reboots) that scripts/qa/production-benchmark.sh reads when present.
#
# Numbered S02 - after S01persistent-datastore/S01wifi (so wlan0/DHCP
# bring-up is already in flight to actually observe) but as early as
# reasonably possible otherwise, so the recorded deltas are meaningful.

LOG="${LOG:-/var/run/rosetteos-boot-timing.log}"
POLL_INTERVAL=1
MAX_WAIT_WLAN0=30
MAX_WAIT_IP=60
MAX_WAIT_SSH=60
MAX_WAIT_MOONRAKER=180

now_uptime() {
	awk '{print $1}' /proc/uptime
}

record() {
	milestone="$1"
	printf '%s %s\n' "$(now_uptime)" "$milestone" >> "$LOG"
}

wait_for() {
	# wait_for <max_wait_seconds> <check_command...>
	max="$1"
	shift
	waited=0
	while [ "$waited" -lt "$max" ]; do
		if "$@" >/dev/null 2>&1; then
			return 0
		fi
		sleep "$POLL_INTERVAL"
		waited=$((waited + POLL_INTERVAL))
	done
	return 1
}

check_wlan0_exists() {
	[ -d /sys/class/net/wlan0 ]
}

check_wlan0_has_ip() {
	ip -4 addr show wlan0 2>/dev/null | grep -q 'inet '
}

check_ssh_listening() {
	awk '
		NR > 1 {
			split($2, local, ":")
			if (local[2] == "0016" && $4 == "0A") { found=1; exit }
		}
		END { exit !found }
	' /proc/net/tcp 2>/dev/null
}

check_moonraker_ready() {
	curl -s --max-time 2 -o /dev/null -w '%{http_code}' "http://127.0.0.1:7125/server/info" 2>/dev/null | grep -q '^200$'
}

run() {
	: > "$LOG"
	ln -sf /var/run/rosetteos-boot-timing.log /var/run/nebulaos-boot-timing.log 2>/dev/null || true
	record boot_timing_started

	if wait_for "$MAX_WAIT_WLAN0" check_wlan0_exists; then
		record wlan0_exists
	else
		record wlan0_exists_timeout
	fi

	if wait_for "$MAX_WAIT_IP" check_wlan0_has_ip; then
		record wlan0_has_ip
	else
		record wlan0_has_ip_timeout
	fi

	if wait_for "$MAX_WAIT_SSH" check_ssh_listening; then
		record ssh_listening
	else
		record ssh_listening_timeout
	fi

	if wait_for "$MAX_WAIT_MOONRAKER" check_moonraker_ready; then
		record moonraker_ready
	else
		record moonraker_ready_timeout
	fi
}

case "$1" in
	start)
		echo "Starting S02rosetteos-boot-timing (background, bounded, non-blocking)"
		start-stop-daemon -S -b -m -p /var/run/rosetteos-boot-timing.pid \
			-x /bin/sh -- "$0" __run
		;;
	stop)
		start-stop-daemon -K -p /var/run/rosetteos-boot-timing.pid 2>/dev/null
		rm -f /var/run/rosetteos-boot-timing.pid
		;;
	__run)
		run
		;;
	*)
		echo "Usage: $0 {start|stop}"
		exit 1
		;;
esac

exit 0

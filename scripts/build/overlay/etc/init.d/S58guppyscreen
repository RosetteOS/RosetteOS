#!/bin/sh
#
# RosetteOS addition: starts GuppyScreen for real local visual feedback during
# the first real boot test - draws directly to the framebuffer/touch device
# built in FIRMWARE.md sec 8-10, independent of network state entirely.
# Real reason this exists now rather than later (originally planned as a
# manual smoke test only): if WiFi doesn't come up on first boot, this is
# the only way to see what's actually happening on the device at all.
#
# Numbered after Moonraker - GuppyScreen is a real-time client of Moonraker's
# websocket API, though it degrades to a reconnecting/error state rather than
# failing outright if Moonraker isn't up yet.

GUPPY_DIR=/opt/guppyscreen
PIDFILE=/var/run/guppyscreen.pid
DATA_ROOT=/usr/data/rosetteos
ACTIVE_TOUCH_FILE=$DATA_ROOT/active_touch_ui
APPS_DIR=$DATA_ROOT/apps

get_touch_binary() {
	active_touch="guppyscreen"
	[ -f "$ACTIVE_TOUCH_FILE" ] && active_touch=$(cat "$ACTIVE_TOUCH_FILE" 2>/dev/null | tr -d ' \r\n')

	if [ "$active_touch" != "guppyscreen" ]; then
		# Check app folder for matching binary or known touchscreen entrypoints
		if [ -x "$APPS_DIR/$active_touch/bin/helix-screen" ]; then
			echo "$APPS_DIR/$active_touch/bin/helix-screen"
			return 0
		elif [ -x "$APPS_DIR/$active_touch/bin/helix-launcher.sh" ]; then
			echo "$APPS_DIR/$active_touch/bin/helix-launcher.sh"
			return 0
		elif [ -x "$APPS_DIR/$active_touch/$active_touch" ]; then
			echo "$APPS_DIR/$active_touch/$active_touch"
			return 0
		elif [ -x "$APPS_DIR/$active_touch/helixscreen" ]; then
			echo "$APPS_DIR/$active_touch/helixscreen"
			return 0
		elif [ -x "$APPS_DIR/$active_touch/guppyscreen" ]; then
			echo "$APPS_DIR/$active_touch/guppyscreen"
			return 0
		fi
		echo "WARNING: Custom touch UI '$active_touch' not found or not executable. Falling back to GuppyScreen." >&2
	fi

	echo "$GUPPY_DIR/guppyscreen"
}

start() {
	TOUCH_BIN=$(get_touch_binary)
	echo "Starting touchscreen UI: $TOUCH_BIN"
	start-stop-daemon -S -b -m -p "$PIDFILE" \
		-x "$TOUCH_BIN"
	# NebulaOS/RosetteOS Memory Resilience Gate: normal/expendable tier - explicit
	# 0 (kernel default) rather than left implicit, so the full priority
	# table is auditable in one place (docs/NEBULAOS_MEMORY_RESILIENCE.md
	# sec 7) rather than "whatever the kernel happened to default to."
	[ -f "$PIDFILE" ] && echo 0 > "/proc/$(cat "$PIDFILE")/oom_score_adj" 2>/dev/null
}

stop() {
	echo "Stopping touchscreen UI"
	start-stop-daemon -K -p "$PIDFILE" -q || true
	# Clean up any residual PID file
	rm -f "$PIDFILE"
}

case "$1" in
	start)
		start
		;;
	stop)
		stop
		;;
	restart)
		stop
		start
		;;
	*)
		echo "Usage: $0 {start|stop|restart}"
		exit 1
		;;
esac

exit 0

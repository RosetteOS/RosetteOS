#!/bin/sh
#
# RosetteOS addition (FIRMWARE.md sec 13): starts Klipper's host-side "klippy"
# process. Must come before S56moonraker, since Moonraker connects to
# klippy's own API-server Unix socket, not the other way around.

KLIPPY=/opt/klipper/klippy/klippy.py
CONFIG=/opt/printer_data/config/printer.cfg
APISOCK=/opt/printer_data/comms/klippy.sock
LOGFILE=/opt/printer_data/logs/klippy.log
PIDFILE=/var/run/klippy.pid

# NebulaOS mutable-runtime closure mission (2026-07-27): prefer the
# writable venv S04rosetteos-factory-seed creates at
# /usr/data/rosetteos/envs/klipper - matches S56moonraker's own identical
# pattern. Required, not cosmetic: Moonraker's update_manager hardcodes
# klipper's AppType/virtualenv detection from Klippy's own reported
# executable (get_base_configuration() in vendor/moonraker's
# update_manager/common.py) with no config override available - running
# under bare /usr/bin/python3 makes Moonraker infer a bogus venv root at
# "/usr" (parent.parent of the executable) and raise a ConfigError that
# crashes the *entire* update_manager component (Moonraker's and
# Mainsail's entries included), confirmed live 2026-07-27. Falls back to
# the system interpreter if the venv doesn't exist yet, same as
# S56moonraker, so this script never fails to start Klipper over a
# missing venv.
PYTHON3=/usr/bin/python3
[ -x /usr/data/rosetteos/envs/klipper/bin/python3 ] && PYTHON3=/usr/data/rosetteos/envs/klipper/bin/python3

# Embedded memory optimizations: strip docstrings/asserts and restrict glibc heap arenas
export PYTHONOPTIMIZE=2
export MALLOC_ARENA_MAX=1

start() {
	echo "Starting klippy (using $PYTHON3)"
	if [ ! -f /opt/klipper/klippy/chelper/c_helper.so ] || [ ! -s /opt/klipper/klippy/chelper/c_helper.so ]; then
		if [ -f /opt/rosetteos-seeds/c_helper.so ]; then
			mkdir -p /opt/klipper/klippy/chelper
			cp /opt/rosetteos-seeds/c_helper.so /opt/klipper/klippy/chelper/c_helper.so 2>/dev/null || true
		fi
	fi
	if [ -f /opt/klipper/klippy/chelper/c_helper.so ]; then
		chelper_dir=/opt/klipper/klippy/chelper
		newest=$(ls -t "$chelper_dir"/*.c "$chelper_dir"/*.h "$chelper_dir"/__init__.py 2>/dev/null | head -1)
		[ -n "$newest" ] && touch -r "$newest" /opt/klipper/klippy/chelper/c_helper.so 2>/dev/null || true
		touch -d "@2000000000" /opt/klipper/klippy/chelper/c_helper.so 2>/dev/null || true
	fi
	start-stop-daemon -S -b -m -p "$PIDFILE" \
		-x "$PYTHON3" -- \
		"$KLIPPY" "$CONFIG" -a "$APISOCK" -l "$LOGFILE"
	# NebulaOS Memory Resilience Gate: Klipper/MCU communication is the
	# most protected process on this system - -700, not -1000 (this
	# mission's own explicit instruction: never indiscriminately assign
	# -1000; the kernel must retain a sensible OOM victim if memory is
	# truly exhausted, not be forced to pick the one process that must
	# never die). See docs/NEBULAOS_MEMORY_RESILIENCE.md sec 7 for the
	# full priority table and reasoning.
	[ -f "$PIDFILE" ] && echo -700 > "/proc/$(cat "$PIDFILE")/oom_score_adj" 2>/dev/null
}

stop() {
	echo "Stopping klippy"
	start-stop-daemon -K -p "$PIDFILE"
}

case "$1" in
	start)
		start
		;;
	stop)
		stop
		;;
	restart)
		stop
		start
		;;
	*)
		echo "Usage: $0 {start|stop|restart}"
		exit 1
		;;
esac

exit 0

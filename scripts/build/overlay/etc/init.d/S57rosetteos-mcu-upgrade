#!/bin/sh
# Automatic printer-MCU upgrade for the Ender-3 V3 KE.
#
# The first custom-image boot uses stage4_first_flash.py because stock
# firmware does not implement the serial bootloader-request path. Once that
# transition succeeds, later image changes use creality_flash.py's normal
# identity-gated path. The persistent image hash makes the operation
# idempotent across boots; a failed operation never records success.
#
# Automatic upgrading is enabled by default. Create
# /usr/data/rosetteos/system/mcu-auto-upgrade.disabled to opt out before boot.

MCU_DIR=/opt/rosetteos/mcu
TOOLS="$MCU_DIR/tools"
PORT=/dev/ttyS1
ROSETTEOS_ROOT="${ROSETTEOS_ROOT:-${NEBULAOS_ROOT:-/usr/data/rosetteos}}"
STATE_DIR="$ROSETTEOS_ROOT/system"
STATE_FILE="$STATE_DIR/mcu-upgrade.state"
LOG_FILE="$ROSETTEOS_ROOT/maintenance/logs/mcu-upgrade.log"
PYTHON="$ROSETTEOS_ROOT/envs/klipper/bin/python3"
[ -x "$PYTHON" ] || PYTHON=/usr/bin/python3

log() {
	msg="S57rosetteos-mcu-upgrade: $1"
	echo "$msg"
	echo "$msg" >> "$LOG_FILE" 2>/dev/null || true
}

image_sha256() {
	sha256sum "$MCU_DIR/klipper-creality.bin" 2>/dev/null | awk '{print $1}'
}

state_matches_image() {
	[ -f "$STATE_FILE" ] || return 1
	grep -q "^image_sha256=$1$" "$STATE_FILE"
}

record_success() {
	tmp="$STATE_FILE.tmp.$$"
	{
		echo "image_sha256=$1"
		echo "completed_at=$(date -u +%Y-%m-%dT%H:%M:%SZ)"
	} > "$tmp" && mv -f "$tmp" "$STATE_FILE"
}

restart_host_services() {
	/etc/init.d/S55klipper restart 2>/dev/null || true
	/etc/init.d/S56moonraker restart 2>/dev/null || true
}

run_first_flash() {
	log "no successful image record - using the stock-to-RosetteOS first-flash path"
	output=$(
		"$PYTHON" "$TOOLS/stage4_first_flash.py" \
			"$MCU_DIR/klipper-creality.bin" \
			"$MCU_DIR/klipper.elf" \
			"$MCU_DIR/klipper.config" \
			--port "$PORT" \
			--expected-sha256 "$EXPECTED_SHA256" \
			--authorize \
			--skip-validator \
			2>&1
	)
	rc=$?
	echo "$output"
	[ "$rc" -eq 0 ] || {
		log "first-flash tool failed (rc=$rc); no success marker written"
		restart_host_services
		return 1
	}
	echo "$output" | grep -q '^FLASH_RESULT=PASS$' || {
		log "first-flash tool did not report FLASH_RESULT=PASS"
		restart_host_services
		return 1
	}
	echo "$output" | grep -q '^APP_START=OK$' || {
		log "first-flash tool did not report APP_START=OK"
		restart_host_services
		return 1
	}
	restart_host_services
	return 0
}

run_update_flash() {
	log "image changed - stopping host services before identity-gated MCU update"
	/etc/init.d/S56moonraker stop 2>/dev/null || true
	/etc/init.d/S55klipper stop 2>/dev/null || true
	output=$(
		"$PYTHON" "$TOOLS/creality_flash.py" flash "$PORT" \
			"$MCU_DIR/klipper-creality.bin" 2>&1
	)
	rc=$?
	echo "$output"
	restart_host_services
	[ "$rc" -eq 0 ] || {
		log "MCU update tool failed (rc=$rc); no success marker written"
		return 1
	}
	return 0
}

start() {
	[ -e "$STATE_DIR/mcu-auto-upgrade.disabled" ] && {
		log "disabled by persistent opt-out marker"
		return 0
	}
	[ -f "$MCU_DIR/manifest.env" ] && [ -f "$MCU_DIR/klipper-creality.bin" ] || {
		log "MCU artifact bundle is missing; leaving printer MCU untouched"
		return 0
	}
	[ -x "$PYTHON" ] || {
		log "no Python interpreter available; leaving printer MCU untouched"
		return 0
	}

	# The generated manifest is shell-compatible and contains only build-time
	# constants. Do not derive the expected hash from the file being checked.
	. "$MCU_DIR/manifest.env"
	EXPECTED_SHA256="$image_sha256"
	actual=$(image_sha256)
	[ -n "$EXPECTED_SHA256" ] && [ "$actual" = "$EXPECTED_SHA256" ] || {
		log "packaged MCU image hash mismatch; refusing to flash"
		return 0
	}

	"$PYTHON" "$TOOLS/creality_validator.py" format \
		"$MCU_DIR/klipper-creality.bin" --expect-type mcu0 >/dev/null 2>&1 || {
		log "packaged MCU image failed format validation; refusing to flash"
		return 0
	}

	state_matches_image "$EXPECTED_SHA256" && {
		log "image $EXPECTED_SHA256 already recorded as successfully flashed"
		return 0
	}

	if [ -f "$STATE_FILE" ]; then
		run_update_flash || return 0
	else
		run_first_flash || return 0
	fi

	record_success "$EXPECTED_SHA256" || {
		log "MCU flash succeeded but state recording failed; next boot will retry"
		return 0
	}
	log "MCU image flashed and recorded successfully"
}

case "$1" in
	start)
		if ! mkdir -p "$STATE_DIR" "$(dirname "$LOG_FILE")"; then
			echo "S57rosetteos-mcu-upgrade: persistent state storage unavailable; leaving printer MCU untouched"
			exit 0
		fi
		start
		;;
	stop)
		:
		;;
	*)
		echo "Usage: $0 {start|stop}"
		exit 1
		;;
esac
exit 0

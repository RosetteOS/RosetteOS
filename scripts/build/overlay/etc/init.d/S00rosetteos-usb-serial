#!/bin/sh
# /etc/init.d/S00rosetteos-usb-serial
# RosetteOS Early Micro-USB Serial Console service.
#
# If a micro-USB cable is connected at boot, /dev/ttyGS0 is present via devtmpfs.
# Starting this at S00 ensures serial console and getty are live immediately at
# the beginning of userspace initialization.

ROSETTEOS_CONSOLE_HELPER="${ROSETTEOS_CONSOLE_HELPER:-/usr/libexec/rosetteos-usb-serial-console}"
DEV_PREFIX="${ROSETTEOS_DEVNODE_PREFIX:-/dev/}"

case "$1" in
	start)
		for sw in /sys/devices/platform/apb/10000000.otg_phy/sw_switch_hsotg /sys/devices/platform/*.otg_phy/sw_switch_hsotg /sys/class/phy/*/sw_switch_hsotg; do
			if [ -f "$sw" ]; then
				echo device > "$sw" 2>/dev/null || true
			fi
		done
		for devnode in "${DEV_PREFIX}"ttyGS[0-9]*; do
			if [ -c "$devnode" ] || [ -f "$devnode" ]; then
				dev="${devnode#"${DEV_PREFIX}"}"
				"$ROSETTEOS_CONSOLE_HELPER" start "$dev"
			fi
		done
		;;
	stop)
		for devnode in "${DEV_PREFIX}"ttyGS[0-9]*; do
			if [ -c "$devnode" ] || [ -f "$devnode" ]; then
				dev="${devnode#"${DEV_PREFIX}"}"
				"$ROSETTEOS_CONSOLE_HELPER" stop "$dev"
			fi
		done
		;;
	status)
		for devnode in "${DEV_PREFIX}"ttyGS[0-9]*; do
			if [ -c "$devnode" ] || [ -f "$devnode" ]; then
				dev="${devnode#"${DEV_PREFIX}"}"
				"$ROSETTEOS_CONSOLE_HELPER" status "$dev"
			fi
		done
		;;
	restart|reload)
		"$0" stop
		"$0" start
		;;
	*)
		echo "Usage: $0 {start|stop|restart|status}" >&2
		exit 1
		;;
esac
exit 0

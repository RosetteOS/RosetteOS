#!/bin/sh
#
# RosetteOS addition: starts touchscreen UI (GuppyScreen, HelixScreen, or custom touch UI)
# draws directly to the framebuffer/touch device independent of network state entirely.
#
# Numbered after Moonraker - Touch UI is a real-time client of Moonraker's
# websocket API, though it degrades to a reconnecting/error state rather than
# failing outright if Moonraker isn't up yet.

GUPPY_DIR=/opt/guppyscreen
ROSEUI_DIR=/opt/roseui
PIDFILE=/var/run/roseui.pid
LEGACY_PIDFILE=/var/run/guppyscreen.pid
DATA_ROOT=/usr/data/rosetteos
ACTIVE_TOUCH_FILE=$DATA_ROOT/active_touch_ui
APPS_DIR=$DATA_ROOT/apps

get_touch_binary() {
	active_touch="roseui"
	[ -f "$ACTIVE_TOUCH_FILE" ] && active_touch=$(cat "$ACTIVE_TOUCH_FILE" 2>/dev/null | tr -d ' \r\n')

	if [ "$active_touch" != "roseui" ] && [ "$active_touch" != "guppyscreen" ]; then
		# Check app folder for matching binary or known touchscreen entrypoints
		if [ -x "$APPS_DIR/$active_touch/bin/helix-screen" ]; then
			echo "$APPS_DIR/$active_touch/bin/helix-screen"
			return 0
		elif [ -x "$APPS_DIR/$active_touch/bin/helix-launcher.sh" ]; then
			echo "$APPS_DIR/$active_touch/bin/helix-launcher.sh"
			return 0
		elif [ -x "$APPS_DIR/$active_touch/$active_touch" ]; then
			echo "$APPS_DIR/$active_touch/$active_touch"
			return 0
		elif [ -x "$APPS_DIR/$active_touch/helixscreen" ]; then
			echo "$APPS_DIR/$active_touch/helixscreen"
			return 0
		elif [ -x "$APPS_DIR/$active_touch/roseui" ]; then
			echo "$APPS_DIR/$active_touch/roseui"
			return 0
		elif [ -x "$APPS_DIR/$active_touch/guppyscreen" ]; then
			echo "$APPS_DIR/$active_touch/guppyscreen"
			return 0
		fi
		echo "WARNING: Custom touch UI '$active_touch' not found or not executable. Falling back to RoseUI." >&2
	fi

	if [ -x "$ROSEUI_DIR/roseui" ]; then
		echo "$ROSEUI_DIR/roseui"
	elif [ -x "$GUPPY_DIR/roseui" ]; then
		echo "$GUPPY_DIR/roseui"
	else
		echo "$GUPPY_DIR/guppyscreen"
	fi
}

ROSETTEOS_OOM_POLICY="${ROSETTEOS_OOM_POLICY:-/etc/rosetteos-oom-policy.sh}"
if [ -r "$ROSETTEOS_OOM_POLICY" ]; then . "$ROSETTEOS_OOM_POLICY"; else rosetteos_start_with_adj() { shift; "$@"; }; fi

wait_for_printer_ready() {
	[ "${TOUCH_UI_NO_WAIT:-0}" = "1" ] && return 0
	timeout="${TOUCH_UI_WAIT_TIMEOUT:-20}"
	elapsed=0
	poll_int="${TOUCH_UI_POLL_INTERVAL:-1}"

	moonraker_pid="${MOONRAKER_PIDFILE:-/var/run/moonraker.pid}"
	klipper_pid="${KLIPPER_PIDFILE:-/var/run/klippy.pid}"
	if [ -z "${MOONRAKER_URL:-}" ] && [ ! -f "$moonraker_pid" ] && [ ! -f "$klipper_pid" ]; then
		return 0
	fi

	echo "Waiting for printer services to become ready (max ${timeout}s)..."
	url="${MOONRAKER_URL:-http://127.0.0.1:7125}/server/info"

	while [ "$elapsed" -lt "$timeout" ]; do
		info=$(wget -q -O - --timeout=1 "$url" 2>/dev/null || true)
		if [ -n "$info" ]; then
			case "$info" in
				*'"klippy_connected":true'*|*'"klippy_connected": true'*)
					case "$info" in
						*'"klippy_state"'*)
							case "$info" in
								*'"klippy_state":"ready"'*|*'"klippy_state": "ready"'*)
									echo "Printer services ready (klippy_connected=true, klippy_state=ready)"
									return 0
									;;
								*'"klippy_state":"error"'*|*'"klippy_state": "error"'*|*'"klippy_state":"shutdown"'*|*'"klippy_state": "shutdown"'*)
									echo "Printer stack in error/shutdown; proceeding with UI launch"
									return 0
									;;
							esac
							;;
						*)
							echo "Printer services ready (klippy_connected=true)"
							return 0
							;;
					esac
					;;
			esac
		fi

		echo "Waiting for printer to initialize..." > /run/rosetteos-boot-status 2>/dev/null || true
		sleep "$poll_int"
		elapsed=$((elapsed + poll_int))
	done

	echo "Printer readiness wait timed out after ${timeout}s; proceeding with UI launch"
	return 0
}

start() {
	wait_for_printer_ready
	echo "Starting touchscreen interface..." > /run/rosetteos-boot-status 2>/dev/null || true
	if [ -x /etc/init.d/S00bootanimation ]; then
		/etc/init.d/S00bootanimation stop 2>/dev/null || true
	fi
	TOUCH_BIN=$(get_touch_binary)
	echo "Starting touchscreen UI: $TOUCH_BIN"
	# OOM priority at birth (MEM-T07): expendable UI tier (0).
	rosetteos_start_with_adj "$ROSETTEOS_ADJ_TOUCH_UI" \
		start-stop-daemon -S -b -m -p "$PIDFILE" \
		-x "$TOUCH_BIN"
}

stop() {
	echo "Stopping touchscreen UI"
	start-stop-daemon -K -p "$PIDFILE" -q || true
	start-stop-daemon -K -p "$LEGACY_PIDFILE" -q 2>/dev/null || true
	# Clean up any residual PID file
	rm -f "$PIDFILE" "$LEGACY_PIDFILE"
}

if [ -z "${TOUCH_UI_NO_AUTORUN:-}" ]; then
	case "${1:-}" in
		start)
			start
			;;
		stop)
			stop
			;;
		restart)
			stop
			start
			;;
		*)
			echo "Usage: $0 {start|stop|restart}"
			exit 1
			;;
	esac
	exit 0
fi

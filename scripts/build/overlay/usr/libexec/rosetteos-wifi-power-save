#!/bin/sh
# RosetteOS Wi-Fi power-save qualification CLI (pre-qualification mission
# Phase A5, 2026-07-31). Thin wrapper around
# /etc/rosetteos-wifi-power-save.sh for interactive/scripted use during
# Phase B4's hardware A/B testing. Never applied automatically outside of
# what /etc/init.d/S01wifi already does at boot per the current marker
# state - this CLI only lets an operator inspect or change that marker,
# and immediately re-apply it without a reboot.

if [ -f /etc/rosetteos-wifi-power-save.sh ]; then
	. /etc/rosetteos-wifi-power-save.sh
fi

usage() {
	echo "usage: $0 {status|enable-experiment|disable-experiment|verify} [iface]" >&2
	exit 1
}

CMD="${1:-}"
IFACE="${2:-wlan0}"
MARKER="${ROSETTEOS_WIFI_PS_MARKER:-/usr/data/rosetteos/maintenance/wifi-power-save-mode}"

case "$CMD" in
	status)
		requested=$(rosetteos_wifi_ps_requested_mode)
		effective=$(rosetteos_wifi_ps_effective_state "$IFACE")
		echo "requested_mode=$requested"
		echo "effective_state=$effective"
		echo "marker_file=$MARKER"
		;;
	enable-experiment)
		mkdir -p "$(dirname "$MARKER")"
		printf 'P1\n' > "$MARKER"
		echo "P1 marker written - applying immediately (also takes effect on next boot without needing this)"
		rosetteos_wifi_ps_apply "$IFACE"
		;;
	disable-experiment)
		rm -f "$MARKER"
		echo "marker removed - reverting to P0 (firmware default) immediately"
		if iw dev "$IFACE" set power_save on 2>/dev/null; then
			echo "power_save on (firmware default) restored on $IFACE"
		else
			echo "warning: could not explicitly restore power_save on for $IFACE - a reboot will still return to the default" >&2
		fi
		;;
	verify)
		requested=$(rosetteos_wifi_ps_requested_mode)
		effective=$(rosetteos_wifi_ps_effective_state "$IFACE")
		case "$requested:$effective" in
			P0:on|P1:off)
				echo "OK: requested=$requested matches effective=$effective on $IFACE"
				exit 0
				;;
			*:unknown)
				echo "UNKNOWN: could not read effective power_save state for $IFACE (interface down or not present?)" >&2
				exit 2
				;;
			*)
				echo "MISMATCH: requested=$requested but effective=$effective on $IFACE" >&2
				exit 1
				;;
		esac
		;;
	*)
		usage
		;;
esac

#!/bin/sh
#
# Human-operator helper for writing /usr/data/rosetteos/display-qualified.conf
# after a real, physical, live-qualification session on the device - this
# script is the "clearly-documented manual command sequence" that later,
# separate phase is expected to drive by hand over SSH. It does not itself
# perform any qualification - it only records the operator's already-
# obtained results, atomically and validated.
#
# Usage: rosetteos-display-qualified-write [KEY=VALUE ...]
#
# Any field from /etc/rosetteos-display-qualified.sh's NDQ_FIELDS list not
# given a KEY=VALUE here falls back to its documented default - UNQUALIFIED
# for anything that would otherwise gate a hardware apply step, or the
# specific inert default for the sleep/touch-wake fields (sleep_enabled=0,
# touch_wake_enabled=0, touch_wake_mode=disabled,
# first_touch_policy=not-implemented) - see ndq_default_for_field(). This
# is what makes "never persist a value that wasn't actually live-qualified"
# automatic rather than something the operator has to remember every time.
#
# touch_wake_mode must always agree with touch_wake_enabled
# (polling<->1, disabled<->0) - ndq_validate() rejects a rendered config
# where they disagree, so this helper will refuse to write one.
#
# Example - a full qualification session that tested irq-assist touch and
# a 50% PWM backlight:
#
#   rosetteos-display-qualified-write \
#     qualification_complete=1 \
#     touch_mode=irq-assist touch_trigger=pendown-gpio-edge \
#     release_stable_samples=3 idle_safety_poll_ms=250 touch_fallback_enabled=1 \
#     backlight_mode=pwm pwm_channel=0 pwm_period_ns=20000 pwm_polarity=normal \
#     pc22_usage=unused \
#     safe_brightness=50 minimum_brightness=25 off_value=0 \
#     sleep_enabled=0 touch_wake_enabled=0 first_touch_policy=not-implemented \
#     qualified_at_utc="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
#
# Example - touch only, backlight qualified as the plain fixed-safe-on
# state (no PWM testing performed, so every pwm_*/safe_brightness field is
# correctly left UNQUALIFIED rather than guessed):
#
#   rosetteos-display-qualified-write \
#     qualification_complete=1 \
#     touch_mode=poll-only touch_trigger=poll \
#     release_stable_samples=3 idle_safety_poll_ms=250 touch_fallback_enabled=1 \
#     backlight_mode=fixed-safe-on \
#     qualified_at_utc="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
#
# Example - sleep capability qualified (backlight-only sleep + polling
# touch-wake), fixed-safe-on backlight, no PWM tested. off_value is
# correctly left UNQUALIFIED - sleep here is GPC0-GPIO-off, not a PWM duty,
# so there is nothing to record there even though sleep_enabled=1:
#
#   rosetteos-display-qualified-write \
#     qualification_complete=1 \
#     touch_mode=poll-only touch_trigger=poll \
#     release_stable_samples=3 idle_safety_poll_ms=250 touch_fallback_enabled=1 \
#     backlight_mode=fixed-safe-on \
#     sleep_enabled=1 touch_wake_enabled=1 touch_wake_mode=polling \
#     qualified_at_utc="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
#
# To withdraw a qualification (revert to "nothing has been tested" without
# deleting the file - e.g. after a hardware change that invalidates
# earlier results): run with no qualification_complete=1 override, i.e.
# just `rosetteos-display-qualified-write` with no arguments, or explicitly
# `rosetteos-display-qualified-write qualification_complete=0`.
#
# Renders the FULL config via ndq_render_config (the same renderer the
# offline tests use), validates the rendered result with the EXACT same
# ndq_validate() the boot-time apply script (S97rosetteos-display-qualified-
# apply) will later run against it, and only writes to disk if that
# validation passes - so a config this helper accepts is guaranteed to be
# one the apply script will actually act on; there is no way for this tool
# and the apply script to silently disagree about what is valid. Refuses
# to write anything at all if validation fails, leaving any previous
# config completely untouched.

set -u

# Overridable so the offline test suite
# (tests/rosetteos-display-qualified-tests.sh) can exercise this helper
# against a fake config directory - the real default is this system's
# real, established library path.
: "${NDQ_LIB:=/etc/rosetteos-display-qualified.sh}"
. "$NDQ_LIB"

TMP_VALIDATE=$(mktemp "${TMPDIR:-/tmp}/rosetteos-display-qualified-write.XXXXXX") || {
	echo "rosetteos-display-qualified-write: mktemp failed" >&2
	exit 1
}
trap 'rm -f "$TMP_VALIDATE"' EXIT INT TERM

ndq_render_config "$@" > "$TMP_VALIDATE"

if ! ndq_validate "$TMP_VALIDATE"; then
	echo "rosetteos-display-qualified-write: refusing to write - the rendered config did not validate (see the reason logged above). Nothing was written to $NDQ_CONFIG_FILE." >&2
	exit 1
fi

if ndq_atomic_write "$NDQ_CONFIG_FILE" < "$TMP_VALIDATE"; then
	echo "rosetteos-display-qualified-write: wrote and validated $NDQ_CONFIG_FILE"
	exit 0
else
	echo "rosetteos-display-qualified-write: atomic write failed - see the reason logged above. Any previous $NDQ_CONFIG_FILE, if one existed, was left untouched." >&2
	exit 1
fi

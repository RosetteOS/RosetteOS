#!/usr/bin/env python3
#
# NebulaOS Moonraker update/camera implementation mission (2026-07-27, see
# docs/NEBULAOS_MOONRAKER_UPDATE_AND_CAMERA_ANALYSIS.md). Seeds exactly one
# database-backed ("source": "database") default webcam for this project's
# one supported printer (Creality Ender-3 V3 KE / Nebula Pad) the first
# time Moonraker is confirmed reachable, using Moonraker's own supported
# HTTP webcam API - never direct SQLite. This exists specifically because
# a config-defined webcam (moonraker.conf's old [webcam Nebula] section)
# is permanently un-editable/un-deletable via Mainsail by Moonraker's own
# design (WebcamManager rejects POST/DELETE for any webcam whose
# source == "config") - a database-backed camera behaves like any normal
# user-added camera instead.
#
# Invoked (backgrounded) by /etc/init.d/S57rosetteos-camera-seed, same
# non-blocking convention as S45rosetteos-cleanup. Uses only the Python
# standard library (urllib, json) - no dependency on Klipper/Moonraker's
# own venvs, so the plain system /usr/bin/python3 is sufficient and used
# by the init script.
#
# Deliberately a single, self-contained script rather than folding this
# into S04rosetteos-factory-seed's own git/venv seeding: this needs to run
# AFTER Moonraker is actually answering HTTP requests (a runtime,
# service-level dependency), not at the namespace/factory-seed stage
# (a filesystem-level one) - mixing the two would make S04's own
# already-complex pause/resume dance around memory-sensitive operations
# harder to reason about for no real benefit.
#
# Testable in full offline: see tests/rosetteos-seed-camera-tests.py, which
# imports this module directly and calls run() with fake fetch/post/sleep/
# log callables and a temp-directory marker path - no real Moonraker, no
# real device, no real network.

from __future__ import annotations

import json
import os
import sys
import time
import urllib.error
import urllib.request

MOONRAKER_BASE = os.environ.get("ROSETTEOS_MOONRAKER_BASE", "http://127.0.0.1:7125")
ROSETTEOS_ROOT = os.environ.get("ROSETTEOS_ROOT", "/usr/data/rosetteos")
MARKER_PATH = os.environ.get(
    "ROSETTEOS_CAMERA_MARKER",
    os.path.join(ROSETTEOS_ROOT, "system", "default-camera-seeded.json"),
)
CAMERA_NAME = "Nebula"

# Nebula Pad / USB camera default configuration for RosetteOS-supported printers.
# The Creality Nebula camera defaults are configured here.
#
# service corrected 2026-07-29: mjpegstreamer-adaptive (originally chosen
# to match the independently investigated camera reference implementation, governing analysis
# report §10/§16) does not actually work on this real device's camera
# stream - confirmed directly by the device owner after editing the live
# database-seeded camera to uv4l-mjpeg to get a working stream, which the
# editable-camera design correctly preserved. uv4l-mjpeg is also
# independently confirmed working for this exact hardware in
# docs/USB_WEBCAM_MISSION_STATUS.md. A fresh install must default to the
# value that actually works, not just one that matches an external
# reference project.
DEFAULT_CAMERA_PAYLOAD = {
    "name": CAMERA_NAME,
    "location": "printer",
    "enabled": True,
    "service": "uv4l-mjpeg",
    "stream_url": "/webcam/?action=stream",
    "snapshot_url": "/webcam/?action=snapshot",
    "target_fps": 30,
    "target_fps_idle": 5,
    "aspect_ratio": "16:9",
    "rotation": 0,
    "flip_horizontal": False,
    "flip_vertical": False,
}

RETRY_ATTEMPTS = int(os.environ.get("ROSETTEOS_CAMERA_SEED_RETRIES", "30"))
RETRY_DELAY_S = float(os.environ.get("ROSETTEOS_CAMERA_SEED_RETRY_DELAY", "2"))


class TransportError(Exception):
    """Raised for any failure to reach Moonraker or parse its response -
    callers must always treat this as "unknown," never "safe to proceed."""


def real_http_get(path: str) -> str:
    with urllib.request.urlopen(MOONRAKER_BASE + path, timeout=5) as resp:
        return resp.read().decode("utf-8")


def real_http_post_json(path: str, payload: dict) -> str:
    data = json.dumps(payload).encode("utf-8")
    req = urllib.request.Request(
        MOONRAKER_BASE + path,
        data=data,
        headers={"Content-Type": "application/json"},
        method="POST",
    )
    with urllib.request.urlopen(req, timeout=8) as resp:
        return resp.read().decode("utf-8")


def _fetch_json(fetch, path: str) -> dict:
    try:
        raw = fetch(path)
    except Exception as exc:  # noqa: BLE001 - any transport failure is equally "unknown"
        raise TransportError(str(exc)) from exc
    if raw is None:
        raise TransportError("no response")
    try:
        return json.loads(raw)
    except Exception as exc:  # noqa: BLE001
        raise TransportError(f"malformed JSON: {exc}") from exc


def list_webcams(fetch) -> list:
    """GET /server/webcams/list, returning the webcams array. Raises
    TransportError on any failure - never returns a guessed/empty list to
    paper over a real communication problem."""
    result = _fetch_json(fetch, "/server/webcams/list")
    return result.get("result", {}).get("webcams", [])


def decide_action(webcams: list, camera_name: str = CAMERA_NAME):
    """Pure decision function over the current webcam list - no I/O, fully
    unit-testable with a plain list of dicts. Returns (action, camera):
      ("adopt", cam)               - a database camera already exists;
                                      preserve it, never duplicate
      ("refuse_config_present", cam) - a config-sourced camera still
                                      exists (should not happen once
                                      moonraker.conf is corrected); refuse
                                      to create a second camera
      ("create", None)             - no cameras of either source exist yet
    """
    db_cams = [w for w in webcams if w.get("source") == "database"]
    config_cams = [w for w in webcams if w.get("source") == "config"]
    if db_cams:
        return ("adopt", db_cams[0])
    if config_cams:
        return ("refuse_config_present", config_cams[0])
    return ("create", None)


def verify_created_camera(webcams: list, expected_name: str = CAMERA_NAME):
    """Re-checks the webcam list after a create POST - never trusts an
    HTTP 2xx alone. Requires exactly one database-sourced camera matching
    the intended name/service/URLs; anything else (zero matches, more
    than one, wrong service/URL) is treated as a failed creation."""
    matches = [
        w
        for w in webcams
        if w.get("source") == "database"
        and w.get("name") == expected_name
        and w.get("service") == DEFAULT_CAMERA_PAYLOAD["service"]
        and w.get("stream_url") == DEFAULT_CAMERA_PAYLOAD["stream_url"]
        and w.get("snapshot_url") == DEFAULT_CAMERA_PAYLOAD["snapshot_url"]
    ]
    return matches[0] if len(matches) == 1 else None


def read_marker(path: str):
    """Returns the parsed marker, or None if absent OR unreadable/malformed
    (a truncated/corrupt marker is treated as "not seeded", never as
    silently "probably fine" - this is what keeps an interrupted write
    from ever producing a false-complete state, see write_marker_atomic)."""
    if not os.path.exists(path):
        return None
    try:
        with open(path) as f:
            return json.load(f)
    except Exception:  # noqa: BLE001
        return None


def write_marker_atomic(path: str, data: dict) -> None:
    """Writes to a .partial file in the same directory, then os.replace()
    (atomic rename) into place - the same .partial-then-rename idiom this
    project already uses for every other seed-once artifact
    (S04rosetteos-factory-seed's own git/mainsail/venv seeding). An
    interruption mid-write leaves only a stray .partial file, which
    read_marker() never looks at - the real marker path either doesn't
    exist yet or holds a fully-written, valid JSON document, never
    something in between."""
    d = os.path.dirname(path)
    os.makedirs(d, exist_ok=True)
    tmp = path + ".partial"
    with open(tmp, "w") as f:
        json.dump(data, f, indent=2)
        f.write("\n")
        f.flush()
        os.fsync(f.fileno())
    os.replace(tmp, path)


def _now() -> str:
    return time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())


def run(
    fetch=real_http_get,
    post=real_http_post_json,
    marker_path: str | None = None,
    log=print,
    retry_attempts: int = RETRY_ATTEMPTS,
    retry_delay: float = RETRY_DELAY_S,
    sleep=time.sleep,
) -> int:
    """Returns 0 on success (including "nothing to do") or 1 on a safe,
    logged, non-fatal failure. Never raises - a boot-time script must not
    take down anything else if Moonraker never comes up."""
    marker_path = marker_path or MARKER_PATH

    marker = read_marker(marker_path)
    if marker is not None:
        log(f"camera seed marker already present ({marker_path}) - nothing to do")
        return 0

    webcams = None
    last_err: Exception | None = None
    for attempt in range(1, retry_attempts + 1):
        try:
            webcams = list_webcams(fetch)
            break
        except TransportError as exc:
            last_err = exc
            log(
                f"attempt {attempt}/{retry_attempts}: Moonraker webcam API "
                f"unavailable ({exc}) - retrying"
            )
            if attempt < retry_attempts:
                sleep(retry_delay)

    if webcams is None:
        log(
            f"Moonraker webcam API never became available after "
            f"{retry_attempts} attempts ({last_err}) - not writing marker; "
            "a later boot or manual invocation may retry"
        )
        return 1

    action, existing = decide_action(webcams)

    if action == "adopt":
        log(
            f"an existing database-backed webcam already exists "
            f"(uid={existing.get('uid')}, name={existing.get('name')!r}) - "
            "adopting it, not creating a duplicate"
        )
        write_marker_atomic(
            marker_path,
            {
                "seeded_at": _now(),
                "result": "existing-database-camera-adopted",
                "uid": existing.get("uid"),
                "name": existing.get("name"),
            },
        )
        log(f"marker written ({marker_path})")
        return 0

    if action == "refuse_config_present":
        log(
            f"a config-sourced webcam still exists (name={existing.get('name')!r}) "
            "- refusing to create a second camera; correct moonraker.conf "
            "and retry, no marker written"
        )
        return 1

    # action == "create"
    log(f"no existing webcam found - creating default camera {CAMERA_NAME!r}")
    try:
        post("/server/webcams/item", DEFAULT_CAMERA_PAYLOAD)
    except Exception as exc:  # noqa: BLE001
        log(f"camera creation POST failed ({exc}) - not writing marker")
        return 1

    try:
        webcams_after = list_webcams(fetch)
    except TransportError as exc:
        log(
            f"could not re-verify the webcam list after creation ({exc}) - "
            "not writing marker (creation may or may not have actually "
            "succeeded; never trust HTTP status alone)"
        )
        return 1

    created = verify_created_camera(webcams_after)
    if created is None:
        log(
            "camera creation POST reported success but verification found "
            "no matching database camera afterward - not writing marker"
        )
        return 1

    write_marker_atomic(
        marker_path,
        {
            "seeded_at": _now(),
            "result": "created",
            "uid": created.get("uid"),
            "name": created.get("name"),
        },
    )
    log(
        f"default camera created and verified (uid={created.get('uid')}) - "
        f"marker written ({marker_path})"
    )
    return 0


if __name__ == "__main__":
    sys.exit(run())

#!/bin/sh
# /usr/libexec/rosetteos-usb-serial-console
# RosetteOS Dynamic Serial Console Helper for USB CDC-ACM (ttyGS0).
# Manages /sbin/getty lifecycle dynamically on USB gadget connect / disconnect events.

set -eu

ACTION="${1:-status}"
DEVICE_ARG="${2:-ttyGS0}"
DEVICE="${DEVICE_ARG#/dev/}"

case "$DEVICE" in
	ttyGS[0-9]*) ;;
	*)
		echo "rosetteos-usb-serial-console: invalid device '$DEVICE' (expected ttyGS[0-9]*)" >&2
		exit 1
		;;
esac

RUNDIR="${ROSETTEOS_RUNDIR:-/run}"
[ -d "$RUNDIR" ] || RUNDIR="/var/run"
PIDFILE="$RUNDIR/rosetteos-usb-serial-${DEVICE}.pid"
DEVNODE="${ROSETTEOS_DEVNODE_PREFIX:-/dev/}$DEVICE"
GETTY_BIN="${ROSETTEOS_GETTY_BIN:-/sbin/getty}"

is_running() {
	if [ -f "$PIDFILE" ]; then
		pid=$(cat "$PIDFILE" 2>/dev/null || true)
		if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
			return 0
		fi
	fi
	return 1
}

do_start() {
	if is_running; then
		pid=$(cat "$PIDFILE" 2>/dev/null || true)
		echo "rosetteos-usb-serial-console: $DEVICE console already running (PID $pid)"
		return 0
	fi

	for sw in /sys/devices/platform/apb/10000000.otg_phy/sw_switch_hsotg /sys/devices/platform/*.otg_phy/sw_switch_hsotg /sys/class/phy/*/sw_switch_hsotg; do
		if [ -f "$sw" ]; then
			echo device > "$sw" 2>/dev/null || true
		fi
	done

	# Wait up to 1 second for device node if invoked immediately by udev
	retries=0
	while [ ! -c "$DEVNODE" ] && [ ! -f "$DEVNODE" ] && [ "$retries" -lt 10 ]; do
		sleep 0.1 2>/dev/null || usleep 100000 2>/dev/null || sleep 1
		retries=$((retries + 1))
	done

	if [ ! -c "$DEVNODE" ] && [ ! -f "$DEVNODE" ]; then
		echo "rosetteos-usb-serial-console: device $DEVNODE does not exist" >&2
		return 1
	fi

	# Launch supervisor loop in background to respawn getty after user logout,
	# terminating when the device node is removed.
	(
		trap 'rm -f "$PIDFILE"; exit 0' TERM INT HUP
		while [ -e "$DEVNODE" ]; do
			printf "\n\033[1;36m=== RosetteOS Micro-USB Serial Console Active (%s) ===\033[0m\n\n" "$DEVICE" > "$DEVNODE" 2>/dev/null || true
			"$GETTY_BIN" -L 115200 "$DEVICE" vt100 2>/dev/null || sleep 1
		done
		rm -f "$PIDFILE"
	) >/dev/null 2>&1 &
	supervisor_pid=$!
	echo "$supervisor_pid" > "$PIDFILE"
	echo "rosetteos-usb-serial-console: started on $DEVICE (PID $supervisor_pid)"
}

do_stop() {
	stopped=0
	if [ -f "$PIDFILE" ]; then
		pid=$(cat "$PIDFILE" 2>/dev/null || true)
		if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
			pkill -f "$GETTY_BIN.*$DEVICE" 2>/dev/null || true
			kill -TERM "$pid" 2>/dev/null || true
			retries=0
			while kill -0 "$pid" 2>/dev/null && [ "$retries" -lt 15 ]; do
				sleep 0.1 2>/dev/null || usleep 100000 2>/dev/null || sleep 1
				retries=$((retries + 1))
			done
			kill -KILL "$pid" 2>/dev/null || true
			stopped=1
		fi
		rm -f "$PIDFILE"
	fi

	# Terminate any remaining getty processes on this tty
	pkill -f "$GETTY_BIN.*$DEVICE" 2>/dev/null || true

	if [ "$stopped" -eq 1 ]; then
		echo "rosetteos-usb-serial-console: stopped on $DEVICE"
	else
		echo "rosetteos-usb-serial-console: $DEVICE was not running"
	fi
}

do_status() {
	if is_running; then
		pid=$(cat "$PIDFILE" 2>/dev/null || true)
		echo "rosetteos-usb-serial-console: $DEVICE running (PID $pid)"
		return 0
	else
		echo "rosetteos-usb-serial-console: $DEVICE not running"
		return 3
	fi
}

case "$ACTION" in
	start)
		do_start
		;;
	stop)
		do_stop
		;;
	restart|reload)
		do_stop
		sleep 1
		do_start
		;;
	status)
		do_status
		;;
	*)
		echo "Usage: $0 {start|stop|restart|status} [device]" >&2
		exit 1
		;;
esac

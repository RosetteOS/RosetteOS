#!/usr/bin/env python3
"""
RosetteOS Multi-Printer Profile Manager
Provides CLI, JSON API, and lifecycle management for printer models on Nebula Pad.
Supports persistent per-profile configuration storage with automatic state restoration.
"""

import sys
import os
import json
import shutil
import argparse
import subprocess
import socket
import urllib.request
from datetime import datetime, timezone

DEFAULT_SEEDS_DIR = "/opt/rosetteos-seeds/printer_profiles"
USER_PROFILES_DIR = "/usr/data/rosetteos/printer_profiles"
CONFIG_DIR = "/usr/data/rosetteos/printer_data/config"
SYSTEM_DIR = "/usr/data/rosetteos/system"
BACKUP_DIR = "/usr/data/rosetteos/backups/printer_config"
ACTIVE_MARKER = os.path.join(SYSTEM_DIR, "active-profile.json")
DEFAULT_PROFILE_ID = "creality-ender3-v3-ke"

def get_seeds_dir():
    return os.environ.get("ROSETTEOS_PROFILES_SEEDS", DEFAULT_SEEDS_DIR)

def get_user_profiles_dir():
    return os.environ.get("ROSETTEOS_USER_PROFILES", USER_PROFILES_DIR)

def get_profile_dirs():
    dirs = []
    user_p = get_user_profiles_dir()
    seeds = get_seeds_dir()
    if os.path.isdir(user_p):
        dirs.append(user_p)
    if os.path.isdir(seeds):
        dirs.append(seeds)
    return dirs

def get_active_profile_id():
    marker_path = os.environ.get("ROSETTEOS_ACTIVE_MARKER", ACTIVE_MARKER)
    if os.path.exists(marker_path):
        try:
            with open(marker_path, "r", encoding="utf-8") as f:
                data = json.load(f)
                return data.get("id", DEFAULT_PROFILE_ID)
        except Exception:
            pass
    return DEFAULT_PROFILE_ID

def load_all_profiles(include_all=False):
    profiles = {}
    active_id = get_active_profile_id()
    user_p = get_user_profiles_dir()
    seeds = get_seeds_dir()

    # First load seed metadata
    if os.path.isdir(seeds):
        for entry in os.listdir(seeds):
            full_path = os.path.join(seeds, entry)
            if not os.path.isdir(full_path):
                continue
            meta_path = os.path.join(full_path, "profile.json")
            cfg_path = os.path.join(full_path, "printer.cfg")
            if os.path.isfile(meta_path) and os.path.isfile(cfg_path):
                try:
                    with open(meta_path, "r", encoding="utf-8") as f:
                        meta = json.load(f)
                    pid = meta.get("id", entry)
                    is_active = (pid == active_id)
                    is_enabled = meta.get("enabled", True) and not meta.get("hidden", False)
                    if not include_all and not is_enabled and not is_active:
                        continue
                    meta["active"] = is_active
                    meta["seed_path"] = full_path
                    user_cfg = os.path.join(user_p, pid, "printer.cfg")
                    meta["has_user_state"] = os.path.isfile(user_cfg)
                    meta["path"] = os.path.join(user_p, pid) if meta["has_user_state"] else full_path
                    profiles[pid] = meta
                except Exception as e:
                    sys.stderr.write(f"Warning: Failed to parse seed profile in {full_path}: {e}\n")

    # Also load any custom user-created profiles not present in seeds
    if os.path.isdir(user_p):
        for entry in os.listdir(user_p):
            if entry in profiles:
                continue
            full_path = os.path.join(user_p, entry)
            if not os.path.isdir(full_path):
                continue
            meta_path = os.path.join(full_path, "profile.json")
            cfg_path = os.path.join(full_path, "printer.cfg")
            if os.path.isfile(meta_path) and os.path.isfile(cfg_path):
                try:
                    with open(meta_path, "r", encoding="utf-8") as f:
                        meta = json.load(f)
                    pid = meta.get("id", entry)
                    is_active = (pid == active_id)
                    is_enabled = meta.get("enabled", True) and not meta.get("hidden", False)
                    if not include_all and not is_enabled and not is_active:
                        continue
                    meta["active"] = is_active
                    meta["has_user_state"] = True
                    meta["path"] = full_path
                    profiles[pid] = meta
                except Exception as e:
                    sys.stderr.write(f"Warning: Failed to parse user profile in {full_path}: {e}\n")

    return profiles

def cmd_list(args):
    profiles = load_all_profiles(include_all=getattr(args, "all", False))
    if args.json:
        print(json.dumps(list(profiles.values()), indent=2))
        return 0
    
    print("Available Printer Profiles:")
    print("-" * 75)
    print(f"{'STATUS':<8} {'ID':<25} {'NAME':<20} {'STATE':<10} {'BED SIZE'}")
    print("-" * 75)
    for pid, p in sorted(profiles.items()):
        status = "[ACTIVE]" if p.get("active") else " "
        state = "Customized" if p.get("has_user_state") else "Default"
        bed = "x".join(map(str, p.get("bed_size", [])))
        print(f"{status:<8} {pid:<25} {p.get('name', pid):<20} {state:<10} {bed}")
    print("-" * 75)
    return 0

def cmd_get(args):
    active_id = get_active_profile_id()
    profiles = load_all_profiles(include_all=True)
    current = profiles.get(active_id, {
        "id": active_id,
        "name": active_id,
        "active": True
    })
    if args.json:
        print(json.dumps(current, indent=2))
    else:
        print(f"Active Profile: {current.get('name', active_id)} ({active_id})")
    return 0

def check_print_in_progress():
    """
    Queries Moonraker or Klipper API to check if a print is currently active or paused.
    Returns (is_printing: bool, state: str or None).
    """
    # 1. Query Moonraker API
    moonraker_port = os.environ.get("ROSETTEOS_MOONRAKER_PORT", "7125")
    moonraker_url = f"http://127.0.0.1:{moonraker_port}/printer/objects/query?print_stats"
    try:
        req = urllib.request.Request(moonraker_url, headers={"User-Agent": "rosetteos-profile"})
        with urllib.request.urlopen(req, timeout=0.8) as resp:
            data = json.loads(resp.read().decode())
            status = data.get("result", {}).get("status", {})
            print_stats = status.get("print_stats", {})
            state = print_stats.get("state", "").strip().lower()
            if state in ["printing", "paused", "busy"]:
                return True, state
    except Exception:
        pass

    # 2. Query Klipper UNIX Domain Socket directly if Moonraker is unreachable
    klippy_sock = os.environ.get("ROSETTEOS_KLIPPY_SOCKET", "/tmp/klippy_uds")
    if not os.path.exists(klippy_sock):
        klippy_sock = "/opt/printer_data/comms/klippy.sock"
    if os.path.exists(klippy_sock):
        try:
            sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
            sock.settimeout(0.8)
            sock.connect(klippy_sock)
            query = json.dumps({"id": 1, "method": "objects/query", "params": {"objects": {"print_stats": None}}}) + "\x03"
            sock.sendall(query.encode())
            raw_resp = sock.recv(4096).decode()
            sock.close()
            if "\x03" in raw_resp:
                raw_resp = raw_resp.split("\x03")[0]
            data = json.loads(raw_resp)
            state = data.get("result", {}).get("status", {}).get("print_stats", {}).get("state", "").strip().lower()
            if state in ["printing", "paused", "busy"]:
                return True, state
        except Exception:
            pass

    return False, None

def check_mcu_architecture_change(current_profile, target_profile, quiet=False):
    """
    Checks if moving between profiles involves a different MCU architecture or firmware requirement,
    and displays clear flashing instructions.
    """
    curr_id = current_profile.get("id", "")
    target_id = target_profile.get("id", "")
    if curr_id == target_id:
        return

    curr_mcu = current_profile.get("mcu", "Unknown")
    target_mcu = target_profile.get("mcu", "Unknown")
    target_name = target_profile.get("name", target_id)
    curr_name = current_profile.get("name", curr_id)

    # Check if MCU hardware or auto-upgrade behavior differs
    is_ke_transition = (curr_id == DEFAULT_PROFILE_ID or target_id == DEFAULT_PROFILE_ID)
    if curr_mcu != target_mcu or is_ke_transition:
        if not quiet:
            print("\n" + "=" * 76)
            print("[NOTICE] Mainboard MCU Architecture Change Detected!")
            print(f"  • Current Profile: {curr_name} ({curr_mcu})")
            print(f"  • Target Profile:  {target_name} ({target_mcu})")
            print("-" * 76)
            print(f"If you are physically connecting the Nebula Pad to an {target_name},")
            print("please ensure the matching Klipper MCU firmware is flashed to the mainboard:")
            if target_id == "creality-ender3-v3-se":
                print("  -> Firmware Binary: Ender3V3SE_klipper.bin (Flash via SD card)")
            elif target_id == "creality-ender3-v2-neo":
                print("  -> Firmware Binary: Ender3V2Neo_klipper.bin (Flash via SD card)")
            elif target_id == "creality-ender3-v3-ke":
                print("  -> Firmware Binary: Built-in / Auto-upgraded via S57rosetteos-mcu-upgrade")
            else:
                print(f"  -> Build binary for {target_mcu} using scripts/build/build-mcu-firmware.sh")
            print("=" * 76 + "\n")

def cmd_show(args):
    profiles = load_all_profiles(include_all=True)
    if args.profile_id not in profiles:
        sys.stderr.write(f"Error: Profile '{args.profile_id}' not found.\n")
        return 1
    print(json.dumps(profiles[args.profile_id], indent=2))
    return 0

def cmd_set(args):
    profiles = load_all_profiles(include_all=True)
    target_id = args.profile_id
    if target_id not in profiles:
        sys.stderr.write(f"Error: Profile '{target_id}' not found.\n")
        return 1
    
    target_profile = profiles[target_id]
    user_p_root = get_user_profiles_dir()
    seeds_root = get_seeds_dir()

    config_dir = os.environ.get("ROSETTEOS_CONFIG_DIR", CONFIG_DIR)
    backup_dir = os.environ.get("ROSETTEOS_BACKUP_DIR", BACKUP_DIR)
    system_dir = os.environ.get("ROSETTEOS_SYSTEM_DIR", SYSTEM_DIR)
    marker_path = os.environ.get("ROSETTEOS_ACTIVE_MARKER", ACTIVE_MARKER)

    # 0. Safety Interlock: Print in progress validation
    if not getattr(args, "force", False):
        is_printing, print_state = check_print_in_progress()
        if is_printing:
            sys.stderr.write(
                f"\n[ERROR] Cannot switch printer profile while a print is actively in progress (state: '{print_state}').\n"
                f"Please cancel or wait for the print job to finish before changing printer models.\n"
                f"Use 'rosetteos-profile set {target_id} --force' if you must override this safety check.\n\n"
            )
            return 1

    os.makedirs(config_dir, exist_ok=True)
    os.makedirs(backup_dir, exist_ok=True)
    os.makedirs(system_dir, exist_ok=True)
    os.makedirs(user_p_root, exist_ok=True)

    dest_cfg = os.path.join(config_dir, "printer.cfg")
    active_id = get_active_profile_id()

    # Show MCU architecture change notice
    current_profile = profiles.get(active_id, {"id": active_id, "name": active_id, "mcu": "Unknown"})
    check_mcu_architecture_change(current_profile, target_profile, quiet=args.quiet)

    # 1. Save currently active profile state and create a timestamped backup
    if os.path.exists(dest_cfg) and not args.no_backup:
        active_user_dir = os.path.join(user_p_root, active_id)
        os.makedirs(active_user_dir, exist_ok=True)
        active_saved_cfg = os.path.join(active_user_dir, "printer.cfg")
        shutil.copy2(dest_cfg, active_saved_cfg)

        active_saved_json = os.path.join(active_user_dir, "profile.json")
        if not os.path.exists(active_saved_json) and active_id in profiles:
            with open(active_saved_json, "w", encoding="utf-8") as f:
                json.dump(profiles[active_id], f, indent=2)

        ts = datetime.now(timezone.utc).strftime("%Y%m%d_%H%M%S")
        backup_file = os.path.join(backup_dir, f"printer.cfg.{ts}.{active_id}")
        shutil.copy2(dest_cfg, backup_file)
        if not args.quiet:
            print(f"Saved active profile state for '{active_id}' -> {active_saved_cfg}")
            print(f"Historical backup created -> {backup_file}")

    # 2. Determine target source configuration
    user_target_cfg = os.path.join(user_p_root, target_id, "printer.cfg")
    seed_target_cfg = os.path.join(seeds_root, target_id, "printer.cfg")

    restored_from_user_state = False
    if os.path.isfile(user_target_cfg) and not args.clean:
        src_cfg = user_target_cfg
        restored_from_user_state = True
    elif os.path.isfile(seed_target_cfg):
        src_cfg = seed_target_cfg
    else:
        src_cfg = os.path.join(target_profile["path"], "printer.cfg")

    if not os.path.isfile(src_cfg):
        sys.stderr.write(f"Error: Target printer.cfg not found at {src_cfg}\n")
        return 1

    shutil.copy2(src_cfg, dest_cfg)
    if not args.quiet:
        if restored_from_user_state:
            print(f"Restored previously saved configuration for: {target_profile.get('name', target_id)}")
        else:
            print(f"Applied factory default configuration for: {target_profile.get('name', target_id)}")

    active_data = {
        "id": target_id,
        "name": target_profile.get("name", target_id),
        "applied_at": datetime.now(timezone.utc).isoformat() + "Z",
        "restored_user_state": restored_from_user_state,
        "bed_size": target_profile.get("bed_size"),
        "probe": target_profile.get("probe"),
        "mcu": target_profile.get("mcu")
    }
    with open(marker_path, "w", encoding="utf-8") as f:
        json.dump(active_data, f, indent=2)

    # Manage MCU auto-upgrade service: only Ender-3 V3 KE uses S57rosetteos-mcu-upgrade
    mcu_disabled_marker = os.path.join(system_dir, "mcu-auto-upgrade.disabled")
    if target_id == DEFAULT_PROFILE_ID:
        if os.path.exists(mcu_disabled_marker):
            try:
                os.remove(mcu_disabled_marker)
            except Exception:
                pass
    else:
        try:
            with open(mcu_disabled_marker, "w", encoding="utf-8") as f:
                f.write(f"disabled for non-KE profile {target_id}\n")
        except Exception:
            pass

    if args.restart:
        if not args.quiet:
            print("Restarting Klipper and Moonraker services...")
        for svc in ["/etc/init.d/S55klipper", "/etc/init.d/S56moonraker"]:
            if os.path.isfile(svc) and os.access(svc, os.X_OK):
                subprocess.run([svc, "restart"], check=False)

    if not args.quiet:
        print(f"Successfully activated profile: {target_profile.get('name', target_id)}")
    return 0

def main():
    parser = argparse.ArgumentParser(description="RosetteOS Printer Profile Manager")
    subparsers = parser.add_subparsers(dest="command", help="Command")

    # list
    p_list = subparsers.add_parser("list", help="List available printer profiles")
    p_list.add_argument("--json", action="store_true", help="Output in JSON format")
    p_list.add_argument("--all", "-a", action="store_true", help="Include hidden/disabled profiles")

    # get
    p_get = subparsers.add_parser("get", help="Get current active profile")
    p_get.add_argument("--json", action="store_true", help="Output in JSON format")

    # show
    p_show = subparsers.add_parser("show", help="Show profile details")
    p_show.add_argument("profile_id", help="Profile ID to inspect")

    # set
    p_set = subparsers.add_parser("set", help="Set active printer profile")
    p_set.add_argument("profile_id", help="Profile ID to activate")
    p_set.add_argument("--clean", "--reset", action="store_true", help="Reset to factory seed ignoring previous saved user state")
    p_set.add_argument("--restart", action="store_true", help="Restart Klipper services after applying")
    p_set.add_argument("--no-backup", action="store_true", help="Do not create a backup of current config")
    p_set.add_argument("--force", "-f", action="store_true", help="Override safety checks (e.g. print in progress)")
    p_set.add_argument("--quiet", "-q", action="store_true", help="Suppress non-error output")

    args = parser.parse_args()
    if not args.command:
        parser.print_help()
        return 1

    if args.command == "list":
        return cmd_list(args)
    elif args.command == "get":
        return cmd_get(args)
    elif args.command == "show":
        return cmd_show(args)
    elif args.command == "set":
        return cmd_set(args)
    return 0

if __name__ == "__main__":
    sys.exit(main())

#!/usr/bin/env python3
"""
OpenKE App Store Engine (openke-app)
Manages installation, updates, removal, and active selection of Web Interfaces,
Touchscreen UIs, and Moonraker Plugins for OpenKE.
All operations are metadata-driven based on the AppStore catalog schema.
"""

import argparse
from datetime import datetime, timezone
import hashlib
import json
import os
import re
import shutil
import ssl
import subprocess
import sys
import tarfile
import tempfile
import time
import urllib.request
import zipfile

DEFAULT_CATALOG_PATHS = [
    "/usr/data/openke/apps.json",
    "/usr/data/openke-seeds/apps.json",
    "/opt/openke-seeds/apps.json",
    "/opt/openke/apps.json",
    "/etc/openke/apps.json",
    "/etc/openke-apps.json",
    # Development repository fallbacks
    os.path.abspath(os.path.join(os.path.dirname(__file__), "../../../../../manifests/apps.json")),
    os.path.abspath(os.path.join(os.path.dirname(__file__), "../../../../manifests/apps.json")),
    os.path.abspath(os.path.join(os.path.dirname(__file__), "../../../manifests/apps.json")),
    os.path.abspath(os.path.join(os.path.dirname(__file__), "../../manifests/apps.json")),
]

DEFAULT_CATALOG_URLS = [
    "http://192.168.1.88:8000/apps.json",
    "http://192.168.1.88:8000/dist/apps.json",
    "https://raw.githubusercontent.com/OpenKlipperEdition/AppStore/main/dist/apps.json",
    "https://raw.githubusercontent.com/OpenKlipperEdition/AppStore/main/apps.json",
    "https://openklipperedition.github.io/AppStore/apps.json",
]

STATE_DIR = os.environ.get("OPENKE_STATE_DIR", "/usr/data/openke")
APPS_DIR = os.environ.get("OPENKE_APPS_DIR", os.path.join(STATE_DIR, "apps"))
SERVICES_DIR = os.environ.get("OPENKE_SERVICES_DIR", os.path.join(STATE_DIR, "services.d"))
INSTALLED_DIR = os.path.join(STATE_DIR, "installed")
COMPONENTS_DIR = os.environ.get("OPENKE_COMPONENTS_DIR", os.path.join(STATE_DIR, "components"))
WEB_ROOT_SYMLINK = os.environ.get("OPENKE_WEB_ROOT_LINK", "/var/run/openke-web-root")
ACTIVE_WEB_FILE = os.path.join(STATE_DIR, "active_web_ui")
ACTIVE_TOUCH_FILE = os.path.join(STATE_DIR, "active_touch_ui")


def get_services_dir() -> str:
    return os.environ.get("OPENKE_SERVICES_DIR", os.path.join(STATE_DIR, "services.d"))


def get_catalog_file() -> str:
    override = os.environ.get("OPENKE_CATALOG_FILE")
    if override and os.path.isfile(override):
        return override
    for p in DEFAULT_CATALOG_PATHS:
        if os.path.isfile(p):
            return p
    return ""


def load_catalog() -> dict:
    cat_path = get_catalog_file()
    if not cat_path:
        return {"version": "1.0", "apps": []}
    try:
        with open(cat_path, "r", encoding="utf-8") as f:
            return json.load(f)
    except Exception as e:
        print(f"ERROR: Failed to load catalog from {cat_path}: {e}", file=sys.stderr)
        return {"version": "1.0", "apps": []}


def get_active_web_ui() -> str:
    if os.path.isfile(ACTIVE_WEB_FILE):
        try:
            with open(ACTIVE_WEB_FILE, "r", encoding="utf-8") as f:
                val = f.read().strip()
                if val:
                    return val
        except Exception:
            pass
    return "mainsail"


def get_active_touch_ui() -> str:
    if os.path.isfile(ACTIVE_TOUCH_FILE):
        try:
            with open(ACTIVE_TOUCH_FILE, "r", encoding="utf-8") as f:
                val = f.read().strip()
                if val:
                    return val
        except Exception:
            pass
    return "guppyscreen"


def get_install_path(app: dict) -> str:
    path = app.get("install_path")
    if not path:
        return os.path.join(APPS_DIR, app.get("id", ""))
    if path.startswith("/usr/data/openke/apps/"):
        rel = os.path.relpath(path, "/usr/data/openke/apps")
        return os.path.join(APPS_DIR, rel)
    return path


def get_probe_path(app: dict) -> str:
    probe = app.get("probe_path")
    if not probe:
        return ""
    if probe.startswith("/usr/data/openke/apps/"):
        rel = os.path.relpath(probe, "/usr/data/openke/apps")
        return os.path.join(APPS_DIR, rel)
    return probe


def is_app_installed(app: dict) -> bool:
    app_id = app.get("id", "")
    if app.get("is_builtin", False):
        builtin_path = app.get("builtin_path", "")
        if builtin_path and os.path.exists(builtin_path):
            return True
        probe = get_probe_path(app)
        if probe and os.path.exists(probe):
            return True
        if app_id in ("mainsail", "guppyscreen"):
            return True
        return False

    # 1. Check persistent installed metadata json
    meta_path = os.path.join(INSTALLED_DIR, f"{app_id}.json")
    if os.path.isfile(meta_path):
        return True

    # 2. Check probe path
    probe = get_probe_path(app)
    if probe and os.path.exists(probe):
        return True

    # 3. Check install path
    install_path = get_install_path(app)
    if install_path and os.path.isdir(install_path):
        return True

    # 4. Check dynamic service runner (enabled S* or disabled K*)
    svc_script = find_app_service_script(app_id)
    if svc_script and os.path.isfile(svc_script):
        return True

    # 5. Check if process is actively running
    pids = find_app_pids(app_id)
    if pids:
        return True

    return False


def get_installed_app_meta(app_id: str) -> dict:
    meta_path = os.path.join(INSTALLED_DIR, f"{app_id}.json")
    if os.path.isfile(meta_path):
        try:
            with open(meta_path, "r", encoding="utf-8") as f:
                return json.load(f)
        except Exception:
            pass
    return {}


def save_installed_app_meta(app: dict):
    os.makedirs(INSTALLED_DIR, exist_ok=True)
    meta_path = os.path.join(INSTALLED_DIR, f"{app['id']}.json")
    try:
        data = {
            "id": app["id"],
            "version": app.get("version", ""),
            "installed_at": datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
        }
        with open(meta_path, "w", encoding="utf-8") as f:
            json.dump(data, f, indent=2)
    except Exception:
        pass


def remove_installed_app_meta(app_id: str):
    meta_path = os.path.join(INSTALLED_DIR, f"{app_id}.json")
    if os.path.isfile(meta_path):
        try:
            os.remove(meta_path)
        except Exception:
            pass


def get_installed_version(app: dict) -> str:
    if not is_app_installed(app):
        return ""
    if app.get("is_builtin", False):
        return app.get("version", "")
    meta = get_installed_app_meta(app["id"])
    if meta.get("version"):
        return meta.get("version")
    return app.get("version", "")


def check_safety_safeguards(action_desc: str, force: bool = False, check_thermal: bool = True):
    if force:
        return

    moonraker_url = os.environ.get("OPENKE_MOONRAKER_URL", "http://127.0.0.1:7125")
    try:
        url = f"{moonraker_url}/printer/objects/query?print_stats&extruder&heater_bed"
        req = urllib.request.urlopen(url, timeout=1.5)
        data = json.loads(req.read().decode("utf-8"))
        status = data.get("result", {}).get("status", {})

        # 1. Active Print Check
        print_stats = status.get("print_stats", {})
        state = print_stats.get("state", "").lower()
        if state in ("printing", "paused"):
            print(f"FATAL: Refusing to {action_desc} while a 3D print is active or paused (state: '{state}').", file=sys.stderr)
            print("Please finish or cancel the active print first, or pass --force to override.", file=sys.stderr)
            sys.exit(1)

        # 2. Thermal & Heater Safeguard
        if check_thermal:
            heaters = []
            extruder = status.get("extruder", {})
            if extruder:
                target = float(extruder.get("target", 0.0))
                temp = float(extruder.get("temperature", 0.0))
                if target > 0.0:
                    heaters.append(f"Hotend heating (target: {target:.0f}°C, temp: {temp:.1f}°C)")

            heater_bed = status.get("heater_bed", {})
            if heater_bed:
                target = float(heater_bed.get("target", 0.0))
                temp = float(heater_bed.get("temperature", 0.0))
                if target > 0.0:
                    heaters.append(f"Bed heating (target: {target:.0f}°C, temp: {temp:.1f}°C)")

            if heaters:
                print(f"FATAL: Refusing to {action_desc} while heaters are actively commanded on:", file=sys.stderr)
                for h in heaters:
                    print(f"  - {h}", file=sys.stderr)
                print("Please turn off heaters (M104 S0 / M140 S0) before switching, or pass --force to override.", file=sys.stderr)
                sys.exit(1)
    except Exception:
        # If Moonraker query fails (e.g. offline during flashing or isolated test sandbox), proceed safely
        pass


def is_print_in_progress() -> bool:
    moonraker_url = os.environ.get("OPENKE_MOONRAKER_URL", "http://127.0.0.1:7125")
    try:
        req = urllib.request.urlopen(f"{moonraker_url}/printer/objects/query?print_stats", timeout=1.5)
        data = json.loads(req.read().decode("utf-8"))
        state = data.get("result", {}).get("status", {}).get("print_stats", {}).get("state", "").lower()
        return state in ("printing", "paused")
    except Exception:
        return False


def get_config_dirs() -> list:
    paths = [
        "/usr/data/printer_data/config",
        "/opt/printer_data/config",
        os.environ.get("OPENKE_PRINTER_DATA_CONFIG", "")
    ]
    return [p for p in paths if p and os.path.isdir(p)]


def get_moonraker_components_dirs() -> list:
    paths = [
        COMPONENTS_DIR,
        os.path.join(STATE_DIR, "components"),
        os.path.join(STATE_DIR, "moonraker-components"),
        "/usr/data/openke/components",
        "/usr/data/openke/moonraker-components",
        "/opt/printer_data/components",
        "/usr/data/printer_data/components",
        "/usr/data/openke/apps/moonraker/moonraker/components",
        "/opt/moonraker/moonraker/components",
        os.environ.get("OPENKE_MOONRAKER_COMPONENTS_DIR", "")
    ]
    res = []
    for p in paths:
        if not p:
            continue
        if p.startswith(STATE_DIR) or p.startswith("/usr/data") or p.startswith("/opt/printer_data"):
            try:
                os.makedirs(p, exist_ok=True)
            except Exception:
                pass
        if os.path.isdir(p) and p not in res:
            res.append(p)
    return res


def get_seed_config(rel_target: str) -> str:
    """
    Finds a local seed file for a given relative config path (e.g. 'macros/fluidd.cfg')
    across firmware seed directories and build tree overlays.
    """
    filename = os.path.basename(rel_target)
    candidates = [
        os.path.join("/opt/openke-seeds/printer_data-config", rel_target),
        os.path.join("/usr/data/openke-seeds/printer_data-config", rel_target),
        os.path.join("/usr/data/printer_data/config", rel_target),
        os.path.join("/opt/printer_data/config", rel_target),
        os.path.join("/opt/openke-seeds/printer_data-config", filename),
        os.path.join("/usr/data/openke-seeds/printer_data-config", filename),
        # Development repository / build tree fallbacks
        os.path.abspath(os.path.join(os.path.dirname(__file__), f"../../opt/printer_data/config/{rel_target}")),
        os.path.abspath(os.path.join(os.path.dirname(__file__), f"../../../opt/printer_data/config/{rel_target}")),
        os.path.abspath(os.path.join(os.path.dirname(__file__), f"../../../scripts/build/overlay/opt/printer_data/config/{rel_target}")),
        os.path.abspath(os.path.join(os.path.dirname(__file__), f"../../../../scripts/build/overlay/opt/printer_data/config/{rel_target}")),
        os.path.abspath(os.path.join(os.path.dirname(__file__), f"../opt/printer_data/config/{rel_target}")),
    ]
    env_cfg = os.environ.get("OPENKE_PRINTER_DATA_CONFIG", "")
    if env_cfg:
        candidates.insert(0, os.path.join(env_cfg, rel_target))

    for c in candidates:
        if os.path.isfile(c):
            return c
    return ""


def format_bytes(size: float) -> str:
    if size < 1024:
        return f"{size:.0f} B"
    elif size < 1024 * 1024:
        return f"{size / 1024:.2f} KB"
    elif size < 1024 * 1024 * 1024:
        return f"{size / (1024 * 1024):.2f} MB"
    else:
        return f"{size / (1024 * 1024 * 1024):.2f} GB"


def get_ssl_context():
    try:
        ctx = ssl.create_default_context()
        ctx.check_hostname = False
        ctx.verify_mode = ssl.CERT_NONE
        return ctx
    except Exception:
        return None


def render_progress_bar(prefix: str, current: int, total: int, suffix: str = "", bar_length: int = 25) -> str:
    cols = shutil.get_terminal_size((80, 24)).columns
    cols = max(40, min(100, cols))

    if total > 0:
        ratio = min(1.0, max(0.0, current / float(total)))
        percent = ratio * 100.0
        overhead = len(prefix) + len(suffix) + 12
        avail_bar = max(10, cols - overhead)
        bar_len = min(bar_length, avail_bar)

        filled_len = int(round(bar_len * ratio))
        filled_len = min(bar_len, max(0, filled_len))
        bar = "=" * filled_len + ("-" * (bar_len - filled_len))
        return f"{prefix} [{bar}] {percent:5.1f}% {suffix}"
    else:
        overhead = len(prefix) + len(suffix) + 4
        avail_bar = max(10, cols - overhead)
        bar_len = min(bar_length, avail_bar)
        pos = (current // 65536) % bar_len
        bar_list = ["-"] * bar_len
        bar_list[pos] = "="
        bar = "".join(bar_list)
        return f"{prefix} [{bar}] {suffix}"


def download_with_progress(url: str, dest_path: str, desc: str = "Downloading") -> bool:
    """
    Streams file download with a live download progress bar showing percent, bytes, and speed.
    """
    os.makedirs(os.path.dirname(dest_path), exist_ok=True)
    temp_dest = dest_path + ".part"
    cols = shutil.get_terminal_size((80, 24)).columns
    cols = max(40, min(100, cols))

    try:
        if url.startswith("file://"):
            local_path = url[7:]
            if not os.path.isfile(local_path):
                print(f"FATAL: Source file not found: {local_path}", file=sys.stderr)
                return False
            total_size = os.path.getsize(local_path)
            downloaded = 0
            start_time = time.time()
            chunk_size = 65536

            with open(local_path, "rb") as src, open(temp_dest, "wb") as dst:
                while True:
                    chunk = src.read(chunk_size)
                    if not chunk:
                        break
                    dst.write(chunk)
                    downloaded += len(chunk)
                    elapsed = time.time() - start_time
                    speed = downloaded / elapsed if elapsed > 0.05 else 0
                    speed_str = f"{format_bytes(speed)}/s"
                    size_str = f"{format_bytes(downloaded)} / {format_bytes(total_size)}"
                    suffix = f"{size_str} ({speed_str})"
                    line = render_progress_bar(f"{desc}:", downloaded, total_size, suffix=suffix, bar_length=25)
                    sys.stdout.write("\r" + line.ljust(cols - 1))
                    sys.stdout.flush()

            elapsed = max(0.001, time.time() - start_time)
            speed = downloaded / elapsed
            speed_str = f"{format_bytes(speed)}/s"
            size_str = f"{format_bytes(downloaded)} / {format_bytes(total_size)}"
            suffix = f"{size_str} ({speed_str})"
            line = render_progress_bar(f"{desc}:", downloaded, total_size, suffix=suffix, bar_length=25)
            sys.stdout.write("\r" + line.ljust(cols - 1) + "\n")
            sys.stdout.flush()

            if os.path.exists(dest_path):
                os.remove(dest_path)
            shutil.move(temp_dest, dest_path)
            return True

        # HTTP/HTTPS download
        ctx = get_ssl_context()
        req = urllib.request.Request(url, headers={"User-Agent": "OpenKE-App/1.0"})
        with urllib.request.urlopen(req, timeout=30, context=ctx) as resp:
            total_size_hdr = resp.headers.get("Content-Length")
            total_size = int(total_size_hdr) if total_size_hdr and total_size_hdr.isdigit() else 0

            downloaded = 0
            chunk_size = 65536
            start_time = time.time()

            with open(temp_dest, "wb") as dst:
                while True:
                    chunk = resp.read(chunk_size)
                    if not chunk:
                        break
                    dst.write(chunk)
                    downloaded += len(chunk)
                    elapsed = time.time() - start_time
                    speed = downloaded / elapsed if elapsed > 0.05 else 0
                    speed_str = f"{format_bytes(speed)}/s"
                    if total_size > 0:
                        size_str = f"{format_bytes(downloaded)} / {format_bytes(total_size)}"
                        suffix = f"{size_str} ({speed_str})"
                        line = render_progress_bar(f"{desc}:", downloaded, total_size, suffix=suffix, bar_length=25)
                    else:
                        size_str = format_bytes(downloaded)
                        suffix = f"{size_str} ({speed_str})"
                        line = render_progress_bar(f"{desc}:", downloaded, 0, suffix=suffix, bar_length=25)

                    sys.stdout.write("\r" + line.ljust(cols - 1))
                    sys.stdout.flush()

            elapsed = max(0.001, time.time() - start_time)
            speed = downloaded / elapsed
            speed_str = f"{format_bytes(speed)}/s"
            if total_size > 0:
                size_str = f"{format_bytes(downloaded)} / {format_bytes(total_size)}"
                suffix = f"{size_str} ({speed_str})"
                line = render_progress_bar(f"{desc}:", downloaded, total_size, suffix=suffix, bar_length=25)
            else:
                size_str = format_bytes(downloaded)
                suffix = f"{size_str} ({speed_str})"
                line = render_progress_bar(f"{desc}:", downloaded, 0, suffix=suffix, bar_length=25)

            sys.stdout.write("\r" + line.ljust(cols - 1) + "\n")
            sys.stdout.flush()

            if os.path.exists(dest_path):
                os.remove(dest_path)
            shutil.move(temp_dest, dest_path)
            return True

    except Exception as e:
        if os.path.exists(temp_dest):
            try:
                os.remove(temp_dest)
            except Exception:
                pass
        sys.stdout.write("\n")
        sys.stdout.flush()
        print(f"FATAL: Download failed from {url}: {e}", file=sys.stderr)
        return False


def extract_with_progress(archive_file: str, stage_dir: str, desc: str = "Installing") -> bool:
    """
    Extracts archive contents into stage_dir with a live installation progress bar showing extracted file count and percent.
    """
    os.makedirs(stage_dir, exist_ok=True)
    cols = shutil.get_terminal_size((80, 24)).columns
    cols = max(40, min(100, cols))

    try:
        if archive_file.endswith(".zip"):
            with zipfile.ZipFile(archive_file, "r") as zf:
                members = zf.infolist()
                total = len(members)
                if total == 0:
                    return True
                for idx, member in enumerate(members, 1):
                    zf.extract(member, stage_dir)
                    mode = member.external_attr >> 16
                    if mode:
                        extracted_path = os.path.join(stage_dir, member.filename)
                        if os.path.exists(extracted_path):
                            try:
                                os.chmod(extracted_path, mode)
                            except Exception:
                                pass
                    suffix = f"({idx}/{total} files)"
                    line = render_progress_bar(f"{desc}:", idx, total, suffix=suffix, bar_length=25)
                    sys.stdout.write("\r" + line.ljust(cols - 1))
                    sys.stdout.flush()
                sys.stdout.write("\n")
                sys.stdout.flush()
                return True

        elif archive_file.endswith((".tar.gz", ".tgz", ".tar.bz2", ".tar.xz", ".tar")):
            with tarfile.open(archive_file, "r:*") as tf:
                members = tf.getmembers()
                total = len(members)
                if total == 0:
                    return True
                for idx, member in enumerate(members, 1):
                    try:
                        tf.extract(member, stage_dir, filter="data")
                    except TypeError:
                        tf.extract(member, stage_dir)
                    suffix = f"({idx}/{total} files)"
                    line = render_progress_bar(f"{desc}:", idx, total, suffix=suffix, bar_length=25)
                    sys.stdout.write("\r" + line.ljust(cols - 1))
                    sys.stdout.flush()
                sys.stdout.write("\n")
                sys.stdout.flush()
                return True

        else:
            try:
                with tarfile.open(archive_file, "r:*") as tf:
                    members = tf.getmembers()
                    total = len(members)
                    for idx, member in enumerate(members, 1):
                        try:
                            tf.extract(member, stage_dir, filter="data")
                        except TypeError:
                            tf.extract(member, stage_dir)
                        suffix = f"({idx}/{total} files)"
                        line = render_progress_bar(f"{desc}:", idx, total, suffix=suffix, bar_length=25)
                        sys.stdout.write("\r" + line.ljust(cols - 1))
                        sys.stdout.flush()
                    sys.stdout.write("\n")
                    sys.stdout.flush()
                    return True
            except Exception:
                try:
                    with zipfile.ZipFile(archive_file, "r") as zf:
                        members = zf.infolist()
                        total = len(members)
                        for idx, member in enumerate(members, 1):
                            zf.extract(member, stage_dir)
                            suffix = f"({idx}/{total} files)"
                            line = render_progress_bar(f"{desc}:", idx, total, suffix=suffix, bar_length=25)
                            sys.stdout.write("\r" + line.ljust(cols - 1))
                            sys.stdout.flush()
                        sys.stdout.write("\n")
                        sys.stdout.flush()
                        return True
                except Exception:
                    dest_file = os.path.join(stage_dir, os.path.basename(archive_file))
                    shutil.copy2(archive_file, dest_file)
                    line = render_progress_bar(f"{desc}:", 1, 1, suffix="(1/1 files)", bar_length=25)
                    sys.stdout.write("\r" + line.ljust(cols - 1) + "\n")
                    sys.stdout.flush()
                    return True
    except Exception as e:
        sys.stdout.write("\n")
        sys.stdout.flush()
        print(f"FATAL: Extraction failed for {archive_file}: {e}", file=sys.stderr)
        return False


def download_file(url: str, dest_path: str) -> bool:
    try:
        os.makedirs(os.path.dirname(dest_path), exist_ok=True)
        if url.startswith("file://"):
            local_path = url[7:]
            if os.path.isfile(local_path):
                shutil.copy2(local_path, dest_path)
                return True
        ctx = get_ssl_context()
        req = urllib.request.Request(url, headers={"User-Agent": "OpenKE-App/1.0"})
        with urllib.request.urlopen(req, timeout=10, context=ctx) as resp:
            data = resp.read()
            if data:
                with open(dest_path, "wb") as f:
                    f.write(data)
                return True
    except Exception:
        pass
    return False


def notify_moonraker_restart():
    try:
        moonraker_url = os.environ.get("OPENKE_MOONRAKER_URL", "http://127.0.0.1:7125")
        req = urllib.request.Request(
            f"{moonraker_url}/server/restart",
            method="POST",
            data=b""
        )
        urllib.request.urlopen(req, timeout=1.0)
    except Exception:
        pass


def install_app_moonraker_components(install_path: str, app: dict):
    """
    Links or copies component python files declared in app['moonraker_component']
    into Moonraker's components directories.
    """
    comp_defs = app.get("moonraker_component")
    if not comp_defs:
        return

    comp_files = []
    if isinstance(comp_defs, str):
        comp_files.append(comp_defs)
    elif isinstance(comp_defs, list):
        comp_files.extend(comp_defs)

    if not comp_files:
        return

    comp_dirs = get_moonraker_components_dirs()
    for rel_comp in comp_files:
        src_comp = os.path.join(install_path, rel_comp)
        if not os.path.isfile(src_comp):
            base_src = os.path.join(install_path, os.path.basename(rel_comp))
            if os.path.isfile(base_src):
                src_comp = base_src

        if not os.path.isfile(src_comp):
            continue

        comp_name = os.path.basename(rel_comp)
        for cdir in comp_dirs:
            dest_comp = os.path.join(cdir, comp_name)
            try:
                if os.path.exists(dest_comp) or os.path.islink(dest_comp):
                    os.remove(dest_comp)
                try:
                    os.symlink(src_comp, dest_comp)
                except OSError:
                    shutil.copy2(src_comp, dest_comp)
                print(f"OK: Linked Moonraker component '{comp_name}' into {dest_comp}")
            except Exception as e:
                print(f"WARNING: Failed linking {dest_comp}: {e}", file=sys.stderr)


def remove_app_moonraker_components(install_path: str, app: dict):
    comp_defs = app.get("moonraker_component")
    if not comp_defs:
        return

    comp_files = []
    if isinstance(comp_defs, str):
        comp_files.append(comp_defs)
    elif isinstance(comp_defs, list):
        comp_files.extend(comp_defs)

    comp_dirs = get_moonraker_components_dirs()
    for rel_comp in comp_files:
        comp_name = os.path.basename(rel_comp)
        for cdir in comp_dirs:
            dest_comp = os.path.join(cdir, comp_name)
            if os.path.exists(dest_comp) or os.path.islink(dest_comp):
                try:
                    os.remove(dest_comp)
                    print(f"OK: Removed Moonraker component {dest_comp}")
                except Exception as e:
                    print(f"WARNING: Failed removing {dest_comp}: {e}", file=sys.stderr)


def install_app_config_files(install_path: str, app: dict):
    """
    Downloads or copies configuration / macro files declared in app['config_target'] / app['config_url'].
    """
    target_rel = app.get("config_target")
    if not target_rel:
        return

    config_url = app.get("config_url")
    cfg_dirs = get_config_dirs()
    seed_file = get_seed_config(target_rel)

    for cfg_dir in cfg_dirs:
        dest_path = os.path.join(cfg_dir, target_rel)
        if not os.path.isfile(dest_path):
            installed = False
            if config_url:
                print(f"Downloading {target_rel} from {config_url}...")
                if download_file(config_url, dest_path):
                    installed = True
                    print(f"OK: Downloaded and installed {dest_path}")

            if not installed and seed_file and os.path.abspath(seed_file) != os.path.abspath(dest_path):
                os.makedirs(os.path.dirname(dest_path), exist_ok=True)
                try:
                    shutil.copy2(seed_file, dest_path)
                    print(f"OK: Installed {dest_path} from local seed")
                except Exception as e:
                    print(f"WARNING: Failed to install {dest_path}: {e}", file=sys.stderr)


def remove_app_config_files(app: dict):
    target_rel = app.get("config_target")
    if not target_rel:
        return

    cfg_dirs = get_config_dirs()
    for cfg_dir in cfg_dirs:
        dest_path = os.path.join(cfg_dir, target_rel)
        if os.path.isfile(dest_path):
            try:
                os.remove(dest_path)
                print(f"OK: Removed {dest_path}")
            except Exception as e:
                print(f"WARNING: Failed to remove {dest_path}: {e}", file=sys.stderr)


def install_app_output_dirs(app: dict):
    """
    Creates any directories declared in app['output_dirs'] under printer_data.
    """
    dirs = app.get("output_dirs", [])
    if isinstance(dirs, str):
        dirs = [dirs]

    cfg_dirs = get_config_dirs()
    for cfg_dir in cfg_dirs:
        printer_data_dir = os.path.dirname(cfg_dir)
        for d in dirs:
            target_dir = os.path.join(printer_data_dir, d) if not os.path.isabs(d) else d
            try:
                os.makedirs(target_dir, exist_ok=True)
            except Exception:
                pass


def install_app_moonraker_conf(install_path: str, app: dict):
    """
    Injects or refreshes custom Moonraker INI sections (from moonraker_config) and
    [update_manager <app_id>] (from moonraker_update_manager) into moonraker.conf.
    """
    app_id = app.get("id", "")
    moonraker_cfg = app.get("moonraker_config", "")
    upd_mgr = app.get("moonraker_update_manager")

    sections_to_add = []

    # 1. Custom moonraker_config block
    if moonraker_cfg:
        sections_to_add.append(moonraker_cfg.strip())

    # 2. Update manager section
    if upd_mgr:
        if isinstance(upd_mgr, dict):
            sec_header = upd_mgr.get("section", f"update_manager {app_id}")
            lines = [f"[{sec_header}]"]
            for k, v in upd_mgr.items():
                if k == "section":
                    continue
                lines.append(f"{k}: {v}")
            if "path" not in upd_mgr:
                lines.append(f"path: {install_path}")
            sections_to_add.append("\n".join(lines))
        elif isinstance(upd_mgr, str):
            sections_to_add.append(upd_mgr.strip().format(install_path=install_path, app_id=app_id))
    elif app.get("category") == "web_ui" and not app.get("is_builtin", False):
        sections_to_add.append(
            f"[update_manager {app_id}]\n"
            f"type: web\n"
            f"channel: stable\n"
            f"repo: {app.get('author', app_id)}/{app_id}\n"
            f"path: {install_path}"
        )

    if not sections_to_add:
        return

    # Clean out any old sections first so that upgrades/reinstalls cleanly update configuration
    remove_app_moonraker_conf(app, notify=False)

    cfg_dirs = get_config_dirs()
    for cfg_dir in cfg_dirs:
        moonraker_conf = os.path.join(cfg_dir, "moonraker.conf")
        if not os.path.isfile(moonraker_conf):
            continue

        try:
            with open(moonraker_conf, "r", encoding="utf-8") as f:
                content = f.read()

            changed = False
            for sec in sections_to_add:
                first_line = sec.splitlines()[0].strip() if sec.splitlines() else ""
                if first_line and first_line in content:
                    continue

                if "[authorization]" in content:
                    content = content.replace("[authorization]", sec + "\n\n[authorization]")
                else:
                    content = content.rstrip() + "\n\n" + sec + "\n"
                changed = True

            if changed:
                with open(moonraker_conf, "w", encoding="utf-8") as f:
                    f.write(content)
                print(f"OK: Added components for {app_id} to {moonraker_conf}")
                notify_moonraker_restart()
        except Exception as e:
            print(f"WARNING: Could not update {moonraker_conf}: {e}", file=sys.stderr)


def remove_app_moonraker_conf(app: dict, notify: bool = True):
    """
    Removes INI sections associated with app from moonraker.conf.
    """
    app_id = app.get("id", "")
    sections_to_remove = set()

    sections_to_remove.add(f"[update_manager {app_id}]")
    sections_to_remove.add(f"[{app_id}]")

    moonraker_cfg = app.get("moonraker_config", "")
    if moonraker_cfg:
        for line in moonraker_cfg.splitlines():
            line = line.strip()
            if line.startswith("[") and line.endswith("]"):
                sections_to_remove.add(line)

    upd_mgr = app.get("moonraker_update_manager")
    if isinstance(upd_mgr, dict) and "section" in upd_mgr:
        sections_to_remove.add(f"[{upd_mgr['section']}]")

    cfg_dirs = get_config_dirs()
    for cfg_dir in cfg_dirs:
        moonraker_conf = os.path.join(cfg_dir, "moonraker.conf")
        if not os.path.isfile(moonraker_conf):
            continue

        try:
            with open(moonraker_conf, "r", encoding="utf-8") as f:
                lines = f.readlines()

            new_lines = []
            in_remove_sec = False
            changed = False

            for line in lines:
                stripped = line.strip()
                if stripped in sections_to_remove:
                    in_remove_sec = True
                    changed = True
                    continue
                elif in_remove_sec:
                    if stripped.startswith("[") and stripped.endswith("]"):
                        in_remove_sec = False
                        if stripped in sections_to_remove:
                            in_remove_sec = True
                            continue
                        new_lines.append(line)
                    else:
                        continue
                else:
                    new_lines.append(line)

            if changed:
                cleaned = "".join(new_lines)
                while "\n\n\n" in cleaned:
                    cleaned = cleaned.replace("\n\n\n", "\n\n")
                with open(moonraker_conf, "w", encoding="utf-8") as f:
                    f.write(cleaned)
                print(f"OK: Cleaned Moonraker configuration for {app_id} in {moonraker_conf}")
                if notify:
                    notify_moonraker_restart()
        except Exception as e:
            print(f"WARNING: Could not update {moonraker_conf}: {e}", file=sys.stderr)


def install_app_printer_cfg(install_path: str, app: dict):
    """
    If app has klipper_include: true, ensures [include <config_target>] is in printer.cfg.
    """
    target_rel = app.get("config_target")
    if not target_rel:
        return

    k_inc = app.get("klipper_include")
    if k_inc is not True:
        return

    cfg_dirs = get_config_dirs()
    for cfg_dir in cfg_dirs:
        printer_cfg = os.path.join(cfg_dir, "printer.cfg")
        if not os.path.isfile(printer_cfg):
            continue

        try:
            with open(printer_cfg, "r", encoding="utf-8") as f:
                content = f.read()

            if f"[include {target_rel}]" not in content:
                if "[include macros/apps.cfg]" in content:
                    content = content.replace("[include macros/apps.cfg]", f"[include {target_rel}]\n[include macros/apps.cfg]")
                elif "[include macros/profiles.cfg]" in content:
                    content = content.replace("[include macros/profiles.cfg]", f"[include macros/profiles.cfg]\n[include {target_rel}]")
                else:
                    content = content.rstrip() + f"\n\n[include {target_rel}]\n"

                with open(printer_cfg, "w", encoding="utf-8") as f:
                    f.write(content)
                print(f"OK: Added [include {target_rel}] to {printer_cfg}")
        except Exception as e:
            print(f"WARNING: Could not update {printer_cfg}: {e}", file=sys.stderr)


def remove_app_printer_cfg(app: dict):
    """
    Removes [include <config_target>] from printer.cfg.
    """
    target_rel = app.get("config_target")
    if not target_rel:
        return

    k_inc = app.get("klipper_include")
    if k_inc is not True and k_inc != "active_only":
        return

    cfg_dirs = get_config_dirs()
    for cfg_dir in cfg_dirs:
        printer_cfg = os.path.join(cfg_dir, "printer.cfg")
        if not os.path.isfile(printer_cfg):
            continue

        try:
            with open(printer_cfg, "r", encoding="utf-8") as f:
                lines = f.readlines()

            new_lines = [l for l in lines if f"[include {target_rel}]" not in l]
            if len(new_lines) != len(lines):
                with open(printer_cfg, "w", encoding="utf-8") as f:
                    f.writelines(new_lines)
                print(f"OK: Removed [include {target_rel}] from {printer_cfg}")
        except Exception as e:
            print(f"WARNING: Could not update {printer_cfg}: {e}", file=sys.stderr)


def sync_web_ui_klipper_macros(target_web_ui: str):
    """
    Synchronizes Klipper client macros in printer.cfg for the active Web UI.
    Discovers all web_ui apps from the catalog, ensures the target Web UI's
    macro file is included, and removes/replaces other web UI macros.
    """
    catalog = load_catalog()
    web_apps = [a for a in catalog.get("apps", []) if a.get("category") == "web_ui"]
    target_app = next((a for a in web_apps if a.get("id") == target_web_ui), None)

    target_macro = target_app.get("config_target", f"macros/{target_web_ui}.cfg") if target_app else f"macros/{target_web_ui}.cfg"
    all_web_macros = {a.get("config_target", f"macros/{a['id']}.cfg") for a in web_apps if a.get("config_target") or a.get("id")}
    all_web_macros.add("macros/mainsail.cfg")
    all_web_macros.add("macros/fluidd.cfg")

    cfg_dirs = get_config_dirs()
    seed_file = get_seed_config(target_macro)

    for cfg_dir in cfg_dirs:
        printer_cfg = os.path.join(cfg_dir, "printer.cfg")
        if not os.path.isfile(printer_cfg):
            continue

        # Ensure active target macro file exists (from seed or download if needed)
        dest_macro_path = os.path.join(cfg_dir, target_macro)
        if not os.path.isfile(dest_macro_path):
            installed = False
            if target_app and target_app.get("config_url"):
                installed = download_file(target_app["config_url"], dest_macro_path)
            if not installed and seed_file and os.path.abspath(seed_file) != os.path.abspath(dest_macro_path):
                os.makedirs(os.path.dirname(dest_macro_path), exist_ok=True)
                try:
                    shutil.copy2(seed_file, dest_macro_path)
                except Exception:
                    pass

        try:
            with open(printer_cfg, "r", encoding="utf-8") as f:
                content = f.read()

            changed = False
            found_existing = False
            for old_macro in all_web_macros:
                old_inc = f"[include {old_macro}]"
                if old_inc in content:
                    found_existing = True
                    if old_macro != target_macro:
                        content = content.replace(old_inc, f"[include {target_macro}]")
                        changed = True

            if not found_existing and f"[include {target_macro}]" not in content:
                if "[include macros/apps.cfg]" in content:
                    content = content.replace("[include macros/apps.cfg]", f"[include {target_macro}]\n[include macros/apps.cfg]")
                elif "[include macros/profiles.cfg]" in content:
                    content = content.replace("[include macros/profiles.cfg]", f"[include macros/profiles.cfg]\n[include {target_macro}]")
                else:
                    content = f"[include {target_macro}]\n" + content
                changed = True

            if changed:
                with open(printer_cfg, "w", encoding="utf-8") as f:
                    f.write(content)
                print(f"OK: Updated {printer_cfg} to include {target_macro}.")

                try:
                    moonraker_url = os.environ.get("OPENKE_MOONRAKER_URL", "http://127.0.0.1:7125")
                    req = urllib.request.Request(
                        f"{moonraker_url}/printer/gcode/script?script=RESTART",
                        method="POST",
                        data=b""
                    )
                    urllib.request.urlopen(req, timeout=1.0)
                except Exception:
                    pass
        except Exception as e:
            print(f"WARNING: Could not update macro include in {printer_cfg}: {e}", file=sys.stderr)


def get_system_total_memory_kb() -> int:
    try:
        with open("/proc/meminfo", "r", encoding="utf-8") as f:
            for line in f:
                if line.startswith("MemTotal:"):
                    return int(line.split()[1])
    except Exception:
        pass
    return 0


def get_system_cpu_jiffies() -> int:
    try:
        with open("/proc/stat", "r", encoding="utf-8") as f:
            line = f.readline()
        return sum(int(x) for x in line.split()[1:])
    except Exception:
        return 0


def find_app_pids(app_id: str) -> list:
    """
    Discovers all process IDs (main PID and child processes) associated with an app.
    """
    normalized_id = re.sub(r"^[SK]\d+", "", app_id).lower()
    pids = set()

    # 1. Check standard PID files
    pid_candidates = [
        f"/var/run/{app_id}.pid",
        f"/var/run/{normalized_id}.pid",
        f"/tmp/{app_id}.pid",
        f"/tmp/{normalized_id}.pid",
        f"/var/run/{app_id}/{app_id}.pid",
        f"/var/run/{normalized_id}/{normalized_id}.pid",
    ]

    svc_script = find_app_service_script(app_id)
    if svc_script and os.path.isfile(svc_script):
        try:
            with open(svc_script, "r", encoding="utf-8", errors="ignore") as f:
                for line in f:
                    if line.strip().startswith("PIDFILE="):
                        val = line.strip().split("=", 1)[1].strip("\"' ")
                        if val and val not in pid_candidates:
                            pid_candidates.insert(0, val)
        except Exception:
            pass

    for pid_file in pid_candidates:
        if os.path.isfile(pid_file):
            try:
                with open(pid_file, "r", encoding="utf-8") as f:
                    content = f.read().strip()
                if content.isdigit():
                    p = int(content)
                    if os.path.isdir(f"/proc/{p}"):
                        pids.add(p)
            except Exception:
                pass

    # 2. Process table scan if no PID found or for active UIs
    if not pids and os.path.isdir("/proc"):
        try:
            for entry in os.listdir("/proc"):
                if entry.isdigit():
                    p = int(entry)
                    cmdline_path = f"/proc/{p}/cmdline"
                    comm_path = f"/proc/{p}/comm"
                    cmdline = ""
                    comm = ""
                    try:
                        with open(cmdline_path, "rb") as f:
                            cmdline = f.read().decode("utf-8", errors="ignore").replace("\x00", " ").strip()
                    except Exception:
                        pass
                    try:
                        with open(comm_path, "r", encoding="utf-8", errors="ignore") as f:
                            comm = f.read().strip()
                    except Exception:
                        pass

                    matched = False
                    if normalized_id in ("guppyscreen", "klipperscreen", "mobileraker", "spoolman", "octoapp", "octoprint"):
                        if comm == normalized_id or comm == app_id:
                            matched = True
                        elif normalized_id == "spoolman" and ("spoolman" in cmdline or "spoolman" in comm):
                            matched = True
                        elif normalized_id == "mobileraker" and ("mobileraker" in cmdline or "mobileraker" in comm):
                            matched = True
                        elif normalized_id == "octoapp" and ("octoapp" in cmdline or "octoapp" in comm):
                            matched = True
                        elif normalized_id == "klipperscreen" and ("KlipperScreen" in cmdline or "klipperscreen" in cmdline):
                            matched = True
                        elif normalized_id == "guppyscreen" and ("guppyscreen" in cmdline or "guppyscreen" in comm):
                            matched = True
                    elif cmdline and (f"/{normalized_id}/" in cmdline or f"/{normalized_id} " in cmdline or f" {normalized_id} " in cmdline or cmdline.endswith(f"/{normalized_id}") or cmdline.endswith(f" {normalized_id}")):
                        matched = True

                    if matched:
                        pids.add(p)
        except Exception:
            pass

    if not pids:
        return []

    # 3. Discover descendant child processes
    all_pids = set(pids)
    if os.path.isdir("/proc"):
        try:
            added = True
            while added:
                added = False
                for entry in os.listdir("/proc"):
                    if entry.isdigit():
                        p = int(entry)
                        if p not in all_pids:
                            try:
                                with open(f"/proc/{p}/stat", "r", encoding="utf-8") as f:
                                    content = f.read()
                                rparen = content.rfind(")")
                                if rparen != -1:
                                    fields = content[rparen + 2:].split()
                                    ppid = int(fields[1])
                                    if ppid in all_pids:
                                        all_pids.add(p)
                                        added = True
                            except Exception:
                                pass
        except Exception:
            pass

    return sorted(list(all_pids))


def get_process_rss_kb(pids: list) -> int:
    total_rss = 0
    for p in pids:
        try:
            with open(f"/proc/{p}/status", "r", encoding="utf-8") as f:
                for line in f:
                    if line.startswith("VmRSS:"):
                        total_rss += int(line.split()[1])
                        break
        except Exception:
            pass
    return total_rss


CPU_CACHE_FILE = "/tmp/.openke_app_cpu_cache.json"


def get_process_cpu_jiffies(pids: list) -> int:
    total_jiffies = 0
    for p in pids:
        if not p or p <= 0:
            continue
        try:
            with open(f"/proc/{p}/stat", "r", encoding="utf-8") as f:
                content = f.read()
            rparen = content.rfind(")")
            if rparen != -1:
                fields = content[rparen + 2:].split()
                # fields[11] is utime, fields[12] is stime (sum across all threads)
                total_jiffies += int(fields[11]) + int(fields[12])
        except Exception:
            pass
    return total_jiffies


def get_apps_resource_usage(app_list: list, sample_cpu: bool = True, sample_interval: float = 0.2) -> dict:
    """
    Computes CPU % and RAM usage for all apps in `app_list`.
    Uses persistent historical tick cache for high resolution & jitter-free metrics.
    Returns a dict mapping app_id -> resource stat dict.
    """
    app_pids_map = {}
    for app in app_list:
        app_id = app.get("id", "")
        pids = find_app_pids(app_id)
        if pids:
            app_pids_map[app_id] = pids

    now = time.time()
    num_cpus = os.cpu_count() or 1
    cpu_map = {}

    if sample_cpu and app_pids_map and os.path.exists("/proc/stat"):
        cache = {}
        if os.path.isfile(CPU_CACHE_FILE):
            try:
                with open(CPU_CACHE_FILE, "r", encoding="utf-8") as f:
                    cache = json.load(f)
            except Exception:
                cache = {}

        cache_time = cache.get("timestamp", 0)
        cache_sys = cache.get("sys_jiffies", 0)
        cache_apps = cache.get("apps", {})

        sys_now = get_system_cpu_jiffies()
        proc_now = {app_id: get_process_cpu_jiffies(pids) for app_id, pids in app_pids_map.items()}

        time_delta = now - cache_time
        # If cache exists and is fresh (0.3s to 15.0s), compute instantaneous delta without sleeping
        if 0.3 <= time_delta <= 15.0 and cache_sys > 0 and sys_now > cache_sys:
            dsys = float(sys_now - cache_sys)
            for app_id, p_now in proc_now.items():
                p_prev = cache_apps.get(app_id, {}).get("proc_jiffies", p_now)
                dproc = max(0.0, float(p_now - p_prev))
                instant_cpu = min(100.0 * num_cpus, (dproc / dsys) * 100.0 * num_cpus)
                prev_smooth = cache_apps.get(app_id, {}).get("smoothed_cpu", instant_cpu)
                smoothed_cpu = round(0.6 * instant_cpu + 0.4 * prev_smooth, 1)
                cpu_map[app_id] = smoothed_cpu
        else:
            # Cold baseline measurement
            baseline_interval = max(0.2, sample_interval)
            time.sleep(baseline_interval)
            sys_after = get_system_cpu_jiffies()
            proc_after = {app_id: get_process_cpu_jiffies(pids) for app_id, pids in app_pids_map.items()}
            dsys = max(1.0, float(sys_after - sys_now))
            for app_id, p_after in proc_after.items():
                p_before = proc_now.get(app_id, p_after)
                dproc = max(0.0, float(p_after - p_before))
                instant_cpu = round(min(100.0 * num_cpus, (dproc / dsys) * 100.0 * num_cpus), 1)
                cpu_map[app_id] = instant_cpu

            sys_now = sys_after
            proc_now = proc_after
            now = time.time()

        # Update cache atomically
        try:
            cache_data = {
                "timestamp": now,
                "sys_jiffies": sys_now,
                "apps": {
                    app_id: {
                        "proc_jiffies": proc_now.get(app_id, 0),
                        "smoothed_cpu": cpu_map.get(app_id, 0.0)
                    }
                    for app_id in proc_now
                }
            }
            tmp_cache = f"{CPU_CACHE_FILE}.tmp.{os.getpid()}"
            with open(tmp_cache, "w", encoding="utf-8") as f:
                json.dump(cache_data, f)
            os.replace(tmp_cache, CPU_CACHE_FILE)
        except Exception:
            pass

    mem_total_kb = get_system_total_memory_kb()
    results = {}

    for app in app_list:
        app_id = app.get("id", "")
        pids = app_pids_map.get(app_id, [])
        if pids:
            main_pid = pids[0]
            rss_kb = get_process_rss_kb(pids)
            ram_bytes = rss_kb * 1024
            ram_mb = round(rss_kb / 1024.0, 1)
            ram_str = format_bytes(ram_bytes)
            ram_pct = round(100.0 * rss_kb / mem_total_kb, 1) if mem_total_kb > 0 else 0.0
            cpu_pct = cpu_map.get(app_id, 0.0)
            res_summary = f"CPU: {cpu_pct:.1f}% | RAM: {ram_str}"
            results[app_id] = {
                "pid": main_pid,
                "pids": pids,
                "is_running": True,
                "cpu_percent": cpu_pct,
                "ram_bytes": ram_bytes,
                "ram_mb": ram_mb,
                "ram_str": ram_str,
                "ram_percent": ram_pct,
                "resource_summary": res_summary
            }
        else:
            results[app_id] = {
                "pid": None,
                "pids": [],
                "is_running": False,
                "cpu_percent": 0.0,
                "ram_bytes": 0,
                "ram_mb": 0.0,
                "ram_str": "",
                "ram_percent": 0.0,
                "resource_summary": ""
            }

    return results


def cmd_list(args):
    catalog = load_catalog()
    apps = catalog.get("apps", [])
    active_web = get_active_web_ui()
    active_touch = get_active_touch_ui()

    stats_map = get_apps_resource_usage(apps, sample_cpu=True, sample_interval=0.1) if args.json or any(is_app_installed(a) for a in apps) else {}

    results = []
    for app in apps:
        cat = app.get("category", "")
        if args.category and cat != args.category:
            continue

        installed = is_app_installed(app)
        app_id = app.get("id", "")
        installed_ver = get_installed_version(app) if installed else ""
        catalog_ver = app.get("version", "")

        has_update = False
        if installed and not app.get("is_builtin", False) and installed_ver and catalog_ver:
            if installed_ver != catalog_ver:
                has_update = True

        is_active = False
        if cat == "web_ui" and app_id == active_web:
            is_active = True
        elif cat == "touch_ui" and app_id == active_touch:
            is_active = True

        status = "available"
        if is_active:
            status = "active"
        elif installed:
            status = "installed"

        app_stats = stats_map.get(app_id, {})
        is_proc_running = app_stats.get("is_running", False)

        svc_script = find_app_service_script(app_id)
        has_service = bool(svc_script or app.get("service") or app.get("service_init"))
        service_enabled = is_app_service_enabled(app_id) if installed and svc_script else (True if has_service else False)
        service_status = "running" if is_proc_running else (get_app_service_status(app_id) if installed and svc_script else ("stopped" if installed and has_service else ""))

        item = {
            "id": app_id,
            "name": app.get("name", app_id),
            "category": cat,
            "icon": app.get("icon", ""),
            "version": catalog_ver,
            "installed_version": installed_ver,
            "has_update": has_update,
            "author": app.get("author", ""),
            "description": app.get("description", ""),
            "is_builtin": app.get("is_builtin", False),
            "is_installed": installed,
            "is_active": is_active,
            "has_service": has_service,
            "service_enabled": service_enabled,
            "service_status": service_status,
            "status": status,
            "pid": app_stats.get("pid"),
            "cpu_percent": app_stats.get("cpu_percent", 0.0),
            "ram_bytes": app_stats.get("ram_bytes", 0),
            "ram_mb": app_stats.get("ram_mb", 0.0),
            "ram_str": app_stats.get("ram_str", ""),
            "ram_percent": app_stats.get("ram_percent", 0.0),
            "resource_summary": app_stats.get("resource_summary", "") if is_proc_running or is_active else ""
        }
        results.append(item)

    if args.json:
        print(json.dumps(results, indent=2))
        return

    # Formatted table output
    print(f"{'ID':<15} {'NAME':<24} {'CATEGORY':<12} {'VERSION':<10} {'INSTALLED':<10} {'STATUS'}")
    print("-" * 82)
    for item in results:
        badge = item["status"].upper()
        if item.get("has_update"):
            badge += " (UPDATE)"
        inst_str = item.get("installed_version") or "-"
        print(f"{item['id']:<15} {item['name'][:23]:<24} {item['category']:<12} {item['version']:<10} {inst_str:<10} {badge}")


def cmd_install(args):
    app_id = args.app_id.lower()
    catalog = load_catalog()
    app = next((a for a in catalog.get("apps", []) if a.get("id") == app_id), None)

    if not app:
        print(f"FATAL: App '{app_id}' not found in catalog.", file=sys.stderr)
        sys.exit(1)

    if app.get("is_builtin", False):
        print(f"App '{app_id}' is a built-in component and is already part of the base firmware.")
        return

    install_path = get_install_path(app)

    download_url = app.get("download_url")
    if not download_url:
        print(f"FATAL: App '{app_id}' has no download_url defined.", file=sys.stderr)
        sys.exit(1)

    print(f"== Installing {app.get('name', app_id)} v{app.get('version', '')} ==")
    os.makedirs(APPS_DIR, exist_ok=True)

    staging_base = os.path.join(STATE_DIR, "tmp")
    os.makedirs(staging_base, exist_ok=True)
    tmp_dir = tempfile.mkdtemp(prefix="openke-app-", dir=staging_base)
    try:
        archive_name = download_url.split("/")[-1].split("?")[0] or "package.tar.gz"
        archive_file = os.path.join(tmp_dir, archive_name)

        print(f"Downloading from {download_url}...")
        if not download_with_progress(download_url, archive_file, desc="Downloading"):
            print(f"FATAL: Failed to download '{download_url}'.", file=sys.stderr)
            sys.exit(1)

        expected_sha = app.get("sha256", "").strip()
        if expected_sha:
            h = hashlib.sha256()
            with open(archive_file, "rb") as f:
                while chunk := f.read(65536):
                    h.update(chunk)
            actual_sha = h.hexdigest()
            if actual_sha.lower() != expected_sha.lower():
                print(f"FATAL: Checksum mismatch for {app_id} (expected {expected_sha}, got {actual_sha}).", file=sys.stderr)
                sys.exit(1)
            print("OK: SHA256 checksum verified.")

        # Staged extraction with install progress bar
        stage_dir = os.path.join(tmp_dir, "extracted")
        os.makedirs(stage_dir, exist_ok=True)

        print(f"Extracting package into flash storage...")
        if not extract_with_progress(archive_file, stage_dir, desc="Installing"):
            print(f"FATAL: Failed to extract package archive.", file=sys.stderr)
            sys.exit(1)

        # Free downloaded archive space immediately
        if os.path.isfile(archive_file):
            try:
                os.remove(archive_file)
            except Exception:
                pass

        # Clean old install if present
        if os.path.exists(install_path):
            if os.path.isdir(install_path):
                shutil.rmtree(install_path)
            else:
                os.remove(install_path)

        os.makedirs(os.path.dirname(install_path), exist_ok=True)
        shutil.move(stage_dir, install_path)

        # Set executable permissions
        for root, dirs, files in os.walk(install_path):
            for f in files:
                fp = os.path.join(root, f)
                if f.endswith(".sh") or f.endswith(".py") or f in (app.get("executable", ""), "helixscreen", "guppyscreen"):
                    try:
                        os.chmod(fp, 0o755)
                    except Exception:
                        pass

        print(f"OK: Successfully installed {app_id} into {install_path}")
        save_installed_app_meta(app)

        # Declarative generic component hooks
        install_app_moonraker_components(install_path, app)
        install_app_config_files(install_path, app)
        install_app_output_dirs(app)
        install_app_moonraker_conf(install_path, app)
        install_app_printer_cfg(install_path, app)
        install_app_service(install_path, app)

        # If set to auto-activate
        if getattr(args, "activate", False):
            cat = app.get("category")
            if cat == "web_ui":
                set_active_web(app_id)
            elif cat == "touch_ui":
                set_active_touch(app_id, force=getattr(args, "force", False))

    finally:
        shutil.rmtree(tmp_dir, ignore_errors=True)


def find_app_service_script(app_id: str) -> str:
    """
    Locates the executable service runner for app_id in services.d or /etc/init.d.
    Handles raw ID ('mobileraker'), S-prefix ('S60mobileraker'), and K-prefix ('K60mobileraker').
    """
    normalized_id = re.sub(r"^[SK]\d+", "", app_id)
    services_dir = get_services_dir()
    if os.path.isdir(services_dir):
        # 1. Exact match
        exact_cand = os.path.join(services_dir, app_id)
        if os.path.isfile(exact_cand):
            return exact_cand

        # 2. Priority or normalized matches
        for fname in sorted(os.listdir(services_dir)):
            cand = os.path.join(services_dir, fname)
            if not os.path.isfile(cand):
                continue
            base = re.sub(r"\.disabled$", "", fname)
            norm_base = re.sub(r"^[SK]\d+", "", base)
            if (fname == app_id or fname == normalized_id or
                base == app_id or norm_base == normalized_id or
                fname == f"S60{normalized_id}" or fname == f"K60{normalized_id}" or
                fname.endswith(f"_{normalized_id}") or fname.endswith(normalized_id)):
                return cand

    # 3. Legacy /etc/init.d/ fallback
    for cand in [f"/etc/init.d/{app_id}", f"/etc/init.d/S60{normalized_id}", f"/etc/init.d/K60{normalized_id}", f"/etc/init.d/{normalized_id}"]:
        if os.path.isfile(cand):
            return cand
    return ""


def is_app_service_enabled(app_id: str) -> bool:
    """
    Returns True if service is enabled to start on boot (S*), False if disabled (K* or .disabled).
    """
    svc_path = find_app_service_script(app_id)
    if not svc_path or not os.path.isfile(svc_path):
        return False
    fname = os.path.basename(svc_path)
    if fname.startswith("K") or fname.endswith(".disabled") or fname.endswith(".bak"):
        return False
    return os.access(svc_path, os.X_OK)


def enable_app_service(app_id: str) -> bool:
    """
    Enables automatic startup on boot for the app service (renames K... -> S...).
    """
    svc_path = find_app_service_script(app_id)
    if not svc_path or not os.path.isfile(svc_path):
        print(f"ERROR: No service runner found for app '{app_id}'", file=sys.stderr)
        return False

    dir_path = os.path.dirname(svc_path)
    fname = os.path.basename(svc_path)

    if fname.startswith("K"):
        new_fname = "S" + fname[1:]
    elif fname.endswith(".disabled"):
        new_fname = fname[:-9]
    elif not fname.startswith("S"):
        new_fname = f"S60{fname}"
    else:
        new_fname = fname

    new_path = os.path.join(dir_path, new_fname)
    if svc_path != new_path:
        try:
            os.rename(svc_path, new_path)
            svc_path = new_path
        except Exception as e:
            print(f"ERROR: Failed enabling service script {svc_path} -> {new_path}: {e}", file=sys.stderr)
            return False

    try:
        os.chmod(svc_path, 0o755)
    except Exception:
        pass

    try:
        subprocess.run([svc_path, "start"], check=False)
    except Exception:
        pass

    print(f"OK: Enabled service for {app_id} ({os.path.basename(svc_path)})")
    return True


def disable_app_service(app_id: str) -> bool:
    """
    Disables automatic startup on boot for the app service (stops and renames S... -> K...).
    """
    svc_path = find_app_service_script(app_id)
    if not svc_path or not os.path.isfile(svc_path):
        print(f"ERROR: No service runner found for app '{app_id}'", file=sys.stderr)
        return False

    try:
        subprocess.run([svc_path, "stop"], check=False)
    except Exception:
        pass

    dir_path = os.path.dirname(svc_path)
    fname = os.path.basename(svc_path)

    if fname.startswith("S"):
        new_fname = "K" + fname[1:]
    elif not fname.startswith("K"):
        new_fname = f"K60{fname}"
    else:
        new_fname = fname

    new_path = os.path.join(dir_path, new_fname)
    if svc_path != new_path:
        try:
            os.rename(svc_path, new_path)
        except Exception as e:
            print(f"ERROR: Failed disabling service script {svc_path} -> {new_path}: {e}", file=sys.stderr)
            return False

    print(f"OK: Disabled service for {app_id} ({os.path.basename(new_path)})")
    return True


def get_app_service_status(app_id: str) -> str:
    """
    Checks the runtime status of an app's background service.
    Returns 'running', 'stopped', or '' if not found.
    """
    svc_path = find_app_service_script(app_id)
    if not svc_path or not os.path.isfile(svc_path) or not os.access(svc_path, os.X_OK):
        return ""
    try:
        res = subprocess.run([svc_path, "status"], stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, timeout=2.0)
        return "running" if res.returncode == 0 else "stopped"
    except Exception:
        return "unknown"


def generate_service_script(app: dict, install_path: str) -> str:
    """
    Generates a standard POSIX SysV start-stop-daemon init script for dynamic services.
    """
    app_id = app.get("id", "")
    app_name = app.get("name", app_id)
    svc_info = app.get("service", {})

    if isinstance(svc_info, str):
        svc_exec = svc_info
        oom_score_adj = -500
        pid_file = f"/var/run/{app_id}.pid"
    elif isinstance(svc_info, dict):
        svc_exec = svc_info.get("exec", "")
        oom_score_adj = svc_info.get("oom_score_adj", -500)
        pid_file = svc_info.get("pid_file", f"/var/run/{app_id}.pid")
    else:
        return ""

    if not svc_exec:
        return ""

    svc_exec = svc_exec.replace("{install_path}", install_path).replace("{app_id}", app_id)

    script = f"""#!/bin/sh
# OpenKE dynamic service runner for {app_name} ({app_id})
# Auto-generated by openke-app

EXEC_CMD="{svc_exec}"
PIDFILE="{pid_file}"
NAME="{app_id}"
DESC="{app_name}"
OOM_ADJ="{oom_score_adj}"
LOGFILE="/var/log/${{NAME}}.log"

# Embedded memory optimizations: strip docstrings/asserts and restrict glibc heap arenas
export PYTHONOPTIMIZE=2
export MALLOC_ARENA_MAX=1

start() {{
	echo -n "Starting $DESC ($NAME)... "
	if [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE" 2>/dev/null)" 2>/dev/null; then
		echo "already running."
		return 0
	fi
	mkdir -p "$(dirname "$LOGFILE")" 2>/dev/null || true
	start-stop-daemon -S -b -m -p "$PIDFILE" -x /bin/sh -- -c "exec $EXEC_CMD >> \"$LOGFILE\" 2>&1"
	status=$?
	if [ $status -eq 0 ]; then
		if [ -n "$OOM_ADJ" ] && [ -f "$PIDFILE" ]; then
			pid=$(cat "$PIDFILE" 2>/dev/null)
			[ -n "$pid" ] && [ -w "/proc/$pid/oom_score_adj" ] && echo "$OOM_ADJ" > "/proc/$pid/oom_score_adj" 2>/dev/null || true
		fi
		echo "OK"
	else
		echo "FAIL ($status)"
	fi
	return $status
}}

stop() {{
	echo -n "Stopping $DESC ($NAME)... "
	if [ -f "$PIDFILE" ]; then
		start-stop-daemon -K -q -p "$PIDFILE"
		status=$?
		rm -f "$PIDFILE"
		echo "OK"
		return $status
	else
		echo "not running."
		return 0
	fi
}}

status() {{
	if [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE" 2>/dev/null)" 2>/dev/null; then
		echo "$NAME (pid $(cat "$PIDFILE" 2>/dev/null)) is running."
		return 0
	else
		echo "$NAME is stopped."
		return 3
	fi
}}

case "$1" in
	start)
		start
		;;
	stop)
		stop
		;;
	restart|reload)
		stop
		sleep 1
		start
		;;
	status)
		status
		;;
	*)
		echo "Usage: $0 {{start|stop|restart|status}}"
		exit 1
		;;
esac
exit 0
"""
    return script


def install_app_service(install_path: str, app: dict):
    """
    Installs dynamic service runner into /usr/data/openke/services.d/ and starts it.
    """
    app_id = app.get("id", "")
    if not app_id:
        return

    services_dir = get_services_dir()
    os.makedirs(services_dir, exist_ok=True)

    priority = 60
    svc_info = app.get("service")
    if isinstance(svc_info, dict):
        priority = svc_info.get("priority", 60)

    target_svc_path = os.path.join(services_dir, f"S{priority}{app_id}")

    # Case 1: Declarative service in manifest
    if svc_info:
        script_code = generate_service_script(app, install_path)
        if script_code:
            try:
                with open(target_svc_path, "w", encoding="utf-8") as f:
                    f.write(script_code)
                os.chmod(target_svc_path, 0o755)
                print(f"OK: Created dynamic service script {target_svc_path}")
            except Exception as e:
                print(f"WARNING: Failed writing service script {target_svc_path}: {e}", file=sys.stderr)

    # Case 2: Custom service_init script provided in app
    elif app.get("service_init"):
        init_src = app["service_init"]
        if not os.path.isabs(init_src):
            init_src = os.path.join(install_path, init_src)
        if os.path.isfile(init_src):
            try:
                shutil.copy2(init_src, target_svc_path)
                os.chmod(target_svc_path, 0o755)
                print(f"OK: Installed dynamic service script {target_svc_path}")
            except Exception as e:
                print(f"WARNING: Failed installing service script: {e}", file=sys.stderr)

    # Ensure all binaries and scripts in install_path are executable
    if os.path.isdir(install_path):
        for root, _, files in os.walk(install_path):
            for f in files:
                fpath = os.path.join(root, f)
                if not f.endswith(('.txt', '.md', '.json', '.conf', '.cfg', '.png', '.jpg', '.css', '.html', '.js')):
                    try:
                        os.chmod(fpath, os.stat(fpath).st_mode | 0o755)
                    except Exception:
                        pass

    # Start the service if script exists
    if os.path.isfile(target_svc_path) and os.access(target_svc_path, os.X_OK):
        try:
            subprocess.run([target_svc_path, "restart"], check=False)
            print(f"OK: Started service via {target_svc_path}")
        except Exception as e:
            print(f"WARNING: Starting service {target_svc_path} failed: {e}", file=sys.stderr)


def remove_app_service(app: dict):
    """
    Stops and removes dynamic service script from services.d directory.
    """
    app_id = app.get("id", "") if app else ""
    if not app_id:
        return

    normalized_id = re.sub(r"^[SK]\d+", "", app_id)
    services_dir = get_services_dir()
    if os.path.isdir(services_dir):
        for fname in os.listdir(services_dir):
            base = re.sub(r"\.disabled$", "", fname)
            norm_base = re.sub(r"^[SK]\d+", "", base)
            if (fname == app_id or fname == normalized_id or
                base == app_id or norm_base == normalized_id or
                fname == f"S60{normalized_id}" or fname == f"K60{normalized_id}" or
                fname.endswith(f"_{normalized_id}") or fname.endswith(normalized_id)):
                svc_path = os.path.join(services_dir, fname)
                if os.path.isfile(svc_path):
                    try:
                        subprocess.run([svc_path, "stop"], check=False)
                        os.remove(svc_path)
                        print(f"OK: Stopped and removed dynamic service {svc_path}")
                    except Exception as e:
                        print(f"WARNING: Failed stopping/removing service {svc_path}: {e}", file=sys.stderr)

    # Fallback to legacy init.d script if present
    for cand in [f"/etc/init.d/S60{normalized_id}", f"/etc/init.d/K60{normalized_id}", f"/etc/init.d/{normalized_id}"]:
        if os.path.isfile(cand) and os.access(cand, os.X_OK):
            try:
                subprocess.run([cand, "stop"], check=False)
                print(f"OK: Stopped legacy service via {cand}")
            except Exception:
                pass


def cmd_service(args):
    action = args.action
    app_id = getattr(args, "app_id", None)
    services_dir = get_services_dir()

    if action == "list":
        if not os.path.isdir(services_dir) or not os.listdir(services_dir):
            print(f"No dynamic services found in {services_dir}")
            return
        catalog = load_catalog()
        apps = catalog.get("apps", [])
        stats_map = get_apps_resource_usage(apps, sample_cpu=True, sample_interval=0.1)

        print("Dynamic Services:")
        print(f"{'SERVICE':<22} {'ENABLED':<9} {'STATUS':<10} {'PID':<8} {'CPU %':<8} {'RAM'}")
        print("-" * 80)
        for fname in sorted(os.listdir(services_dir)):
            svc_path = os.path.join(services_dir, fname)
            if not os.path.isfile(svc_path):
                continue
            base = re.sub(r"\.disabled$", "", fname)
            norm_id = re.sub(r"^[SK]\d+", "", base)
            is_en = not fname.startswith("K") and not fname.endswith(".disabled") and os.access(svc_path, os.X_OK)
            enabled_str = "yes" if is_en else "no"
            res = subprocess.run([svc_path, "status"], stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)
            stats = stats_map.get(norm_id, {})
            is_running = res.returncode == 0 or stats.get("is_running", False)
            status_text = "running" if is_running else "stopped"
            pid_str = str(stats.get("pid")) if stats.get("pid") is not None else "-"
            cpu_str = f"{stats.get('cpu_percent', 0.0):.1f}%" if is_running else "-"
            ram_str = f"{stats.get('ram_str', '-')} ({stats.get('ram_percent', 0.0):.1f}%)" if is_running and stats.get("ram_bytes", 0) > 0 else "-"
            print(f"{fname:<22} {enabled_str:<9} {status_text:<10} {pid_str:<8} {cpu_str:<8} {ram_str}")
        return

    if not app_id:
        print(f"ERROR: App ID required for service {action}", file=sys.stderr)
        sys.exit(1)

    if action == "enable":
        ok = enable_app_service(app_id)
        sys.exit(0 if ok else 1)

    if action == "disable":
        ok = disable_app_service(app_id)
        sys.exit(0 if ok else 1)

    if action == "is-enabled":
        enabled = is_app_service_enabled(app_id)
        print("enabled" if enabled else "disabled")
        sys.exit(0 if enabled else 1)

    svc_path = find_app_service_script(app_id)
    if not svc_path:
        print(f"ERROR: No service found for app '{app_id}' in {services_dir} or /etc/init.d", file=sys.stderr)
        sys.exit(1)

    if action == "status":
        res = subprocess.run([svc_path, "status"], stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)
        stats_map = get_apps_resource_usage([{"id": app_id}], sample_cpu=True, sample_interval=0.1)
        stats = stats_map.get(app_id, {})
        is_running = res.returncode == 0 or stats.get("is_running", False)
        if is_running:
            pid = stats.get("pid")
            res_info = f" [CPU: {stats.get('cpu_percent', 0.0):.1f}%, RAM: {stats.get('ram_str', '-')} ({stats.get('ram_percent', 0.0):.1f}%)]" if stats.get("ram_bytes", 0) > 0 else ""
            out = res.stdout.strip()
            if out:
                if out.endswith("."):
                    out = out[:-1]
                print(f"{out}.{res_info}")
            else:
                print(f"{app_id} (pid {pid}) is running.{res_info}")
            sys.exit(0)
        else:
            out = res.stdout.strip()
            print(out if out else f"{app_id} is stopped.")
            sys.exit(res.returncode if res.returncode != 0 else 3)

    res = subprocess.run([svc_path, action])
    sys.exit(res.returncode)


def cmd_remove(args):
    app_id = args.app_id.lower()
    catalog = load_catalog()
    app = next((a for a in catalog.get("apps", []) if a.get("id") == app_id), None)

    if app and app.get("is_builtin", False):
        print(f"FATAL: App '{app_id}' is a built-in firmware component and cannot be removed.", file=sys.stderr)
        sys.exit(1)

    install_path = get_install_path(app) if app else os.path.join(APPS_DIR, app_id)
    force = getattr(args, "force", False)

    # Active fallback safety
    if get_active_web_ui() == app_id:
        print(f"App '{app_id}' is currently active as Web UI. Reverting active Web UI to Mainsail...")
        set_active_web("mainsail", force=force)

    if get_active_touch_ui() == app_id:
        print(f"App '{app_id}' is currently active as Touch UI. Reverting active Touch UI to GuppyScreen...")
        set_active_touch("guppyscreen", force=force)

    # Stop and remove dynamic service if present
    if app:
        remove_app_service(app)
    else:
        remove_app_service({"id": app_id})

    if os.path.exists(install_path):
        if os.path.isdir(install_path):
            shutil.rmtree(install_path)
        else:
            os.remove(install_path)
        print(f"OK: Removed {app_id} from {install_path}")
    else:
        print(f"App '{app_id}' was not installed.")

    remove_installed_app_meta(app_id)

    # Declarative generic component cleanup
    if app:
        remove_app_moonraker_components(install_path, app)
        remove_app_config_files(app)
        remove_app_moonraker_conf(app)
        remove_app_printer_cfg(app)


def set_active_web(target: str, force: bool = False):
    target = target.lower()
    check_safety_safeguards(f"switch Web UI to '{target}'", force=force, check_thermal=False)

    catalog = load_catalog()
    app = next((a for a in catalog.get("apps", []) if a.get("id") == target and a.get("category") == "web_ui"), None)

    target_dir = ""
    if target == "mainsail":
        target_dir = os.environ.get("OPENKE_MAINSAIL_DIR", "/usr/share/mainsail")
    elif app:
        target_dir = get_install_path(app)
    else:
        target_dir = os.path.join(APPS_DIR, target)

    if not os.path.exists(target_dir) and target != "mainsail":
        print(f"FATAL: Web UI '{target}' is not installed at {target_dir}.", file=sys.stderr)
        sys.exit(1)

    os.makedirs(STATE_DIR, exist_ok=True)
    with open(ACTIVE_WEB_FILE, "w", encoding="utf-8") as f:
        f.write(target + "\n")

    # Update dynamic symlink
    if os.path.islink(WEB_ROOT_SYMLINK) or os.path.exists(WEB_ROOT_SYMLINK):
        try:
            os.remove(WEB_ROOT_SYMLINK)
        except Exception:
            pass
    try:
        os.symlink(target_dir, WEB_ROOT_SYMLINK)
    except Exception as e:
        print(f"WARNING: Could not symlink {WEB_ROOT_SYMLINK} -> {target_dir}: {e}", file=sys.stderr)

    # Sync Klipper client macros dynamically
    sync_web_ui_klipper_macros(target)

    # Reload nginx if running
    try:
        subprocess.run(["nginx", "-s", "reload"], check=False, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except Exception:
        pass
    try:
        subprocess.run(["killall", "-HUP", "nginx"], check=False, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except Exception:
        pass

    print(f"OK: Active Web UI switched to '{target}' ({target_dir}).")


def set_active_touch(target: str, force: bool = False):
    target = target.lower()
    check_safety_safeguards(f"switch Touchscreen UI to '{target}'", force=force, check_thermal=True)

    catalog = load_catalog()
    app = next((a for a in catalog.get("apps", []) if a.get("id") == target and a.get("category") == "touch_ui"), None)

    if target != "guppyscreen":
        probe = get_probe_path(app) if app else os.path.join(APPS_DIR, target, target)
        if not probe or not os.path.exists(probe):
            print(f"FATAL: Touch UI '{target}' is not installed (expected executable at {probe}).", file=sys.stderr)
            sys.exit(1)

    os.makedirs(STATE_DIR, exist_ok=True)
    with open(ACTIVE_TOUCH_FILE, "w", encoding="utf-8") as f:
        f.write(target + "\n")

    # Trigger restart of display service
    init_script = "/etc/init.d/S58guppyscreen"
    if os.path.isfile(init_script) and os.access(init_script, os.X_OK):
        try:
            subprocess.run([init_script, "restart"], check=False)
        except Exception as e:
            print(f"WARNING: Restarting touch display service failed: {e}", file=sys.stderr)

    print(f"OK: Active Touch UI set to '{target}'.")


def cmd_update(args):
    urls = []
    if getattr(args, "url", None):
        urls.append(args.url)
    else:
        env_url = os.environ.get("OPENKE_CATALOG_URL")
        if env_url:
            urls.append(env_url)
        urls.extend(DEFAULT_CATALOG_URLS)

    target = os.path.join(STATE_DIR, "apps.json")
    success = False

    for url in urls:
        fetch_url = url
        if url.startswith("http://") or url.startswith("https://"):
            sep = "&" if "?" in url else "?"
            fetch_url = f"{url}{sep}t={int(time.time())}"
        print(f"Checking for catalog updates from {url}...")
        try:
            req = urllib.request.Request(
                fetch_url,
                headers={
                    "User-Agent": "OpenKE-App/1.0",
                    "Cache-Control": "no-cache, no-store",
                    "Pragma": "no-cache",
                }
            )
            with urllib.request.urlopen(req, timeout=10) as resp:
                status = getattr(resp, "status", 200)
                if status in (200, None):
                    raw = resp.read().decode("utf-8")
                    data = json.loads(raw)
                    if "apps" in data and isinstance(data["apps"], list):
                        os.makedirs(STATE_DIR, exist_ok=True)
                        tmp_target = target + ".tmp"
                        with open(tmp_target, "w", encoding="utf-8") as f:
                            json.dump(data, f, indent=2)
                        os.replace(tmp_target, target)
                        print(f"OK: Updated catalog ({len(data['apps'])} apps) from {url}")
                        success = True
                        break
        except Exception as e:
            print(f"NOTE: Could not fetch from {url} ({e})")

    if not success:
        print("INFO: Keeping existing local catalog.", file=sys.stderr)


def cmd_upgrade(args):
    catalog = load_catalog()
    apps = catalog.get("apps", [])

    target_id = getattr(args, "app_id", None)
    if getattr(args, "all", False) or target_id in (None, "all", ""):
        upgraded_count = 0
        for app in apps:
            if is_app_installed(app) and not app.get("is_builtin", False):
                inst_ver = get_installed_version(app)
                cat_ver = app.get("version", "")
                if inst_ver and cat_ver and inst_ver != cat_ver:
                    print(f"\n== Upgrading {app.get('name', app['id'])} ({inst_ver} -> {cat_ver}) ==")
                    args.app_id = app["id"]
                    args.activate = False
                    cmd_install(args)
                    upgraded_count += 1
        if upgraded_count == 0:
            print("All installed apps are already up to date.")
        else:
            print(f"\nOK: Successfully upgraded {upgraded_count} app(s).")
        return

    app_id = target_id.lower()
    app = next((a for a in apps if a.get("id") == app_id), None)
    if not app:
        print(f"FATAL: App '{app_id}' not found in catalog.", file=sys.stderr)
        sys.exit(1)

    if not is_app_installed(app):
        print(f"App '{app_id}' is not currently installed. Installing latest version...")
    else:
        inst_ver = get_installed_version(app)
        cat_ver = app.get("version", "")
        if inst_ver == cat_ver:
            print(f"App '{app_id}' is already at latest version ({cat_ver}). Reinstalling...")
        else:
            print(f"Upgrading '{app_id}' from v{inst_ver} to v{cat_ver}...")

    args.app_id = app_id
    args.activate = False
    cmd_install(args)


def cmd_set_active_web(args):
    set_active_web(args.app_id, force=getattr(args, "force", False))


def cmd_set_active_touch(args):
    set_active_touch(args.app_id, force=getattr(args, "force", False))


def cmd_top(args):
    catalog = load_catalog()
    apps = catalog.get("apps", [])
    active_web = get_active_web_ui()
    active_touch = get_active_touch_ui()

    stats_map = get_apps_resource_usage(apps, sample_cpu=True, sample_interval=0.15)
    mem_total_kb = get_system_total_memory_kb()

    active_items = []
    total_app_rss_kb = 0

    for app in apps:
        app_id = app.get("id", "")
        cat = app.get("category", "")
        installed = is_app_installed(app)
        stats = stats_map.get(app_id, {})
        is_running = stats.get("is_running", False)

        is_active = False
        if cat == "web_ui" and app_id == active_web:
            is_active = True
        elif cat == "touch_ui" and app_id == active_touch:
            is_active = True

        status_text = "stopped"
        if is_active:
            status_text = "active"
        elif is_running:
            status_text = "running"
        elif installed:
            status_text = "installed"
        else:
            status_text = "available"

        if is_running or is_active or (installed and getattr(args, "all", False)):
            if is_running:
                total_app_rss_kb += stats.get("ram_bytes", 0) // 1024
            active_items.append({
                "id": app_id,
                "name": app.get("name", app_id),
                "category": cat,
                "status": status_text,
                "pid": stats.get("pid"),
                "cpu_percent": stats.get("cpu_percent", 0.0),
                "ram_bytes": stats.get("ram_bytes", 0),
                "ram_mb": stats.get("ram_mb", 0.0),
                "ram_str": stats.get("ram_str", "-"),
                "ram_percent": stats.get("ram_percent", 0.0),
                "resource_summary": stats.get("resource_summary", "")
            })

    if getattr(args, "json", False):
        print(json.dumps(active_items, indent=2))
        return

    print("OpenKE Active Apps Resource Usage:")
    print(f"{'ID':<15} {'NAME':<24} {'CATEGORY':<12} {'STATUS':<10} {'PID':<8} {'CPU %':<8} {'RAM'}")
    print("-" * 92)
    if not active_items:
        print("No active application processes found.")
    else:
        for item in active_items:
            pid_str = str(item["pid"]) if item["pid"] is not None else "-"
            cpu_str = f"{item['cpu_percent']:.1f}%" if item["pid"] is not None else "-"
            ram_str = f"{item['ram_str']} ({item['ram_percent']:.1f}%)" if item["ram_bytes"] > 0 else "-"
            print(f"{item['id']:<15} {item['name'][:23]:<24} {item['category']:<12} {item['status']:<10} {pid_str:<8} {cpu_str:<8} {ram_str}")

    if mem_total_kb > 0:
        total_pct = round(100.0 * total_app_rss_kb / mem_total_kb, 1)
        print("-" * 92)
        print(f"Total System Memory: {format_bytes(mem_total_kb * 1024)} | Active App Footprint: {format_bytes(total_app_rss_kb * 1024)} ({total_pct}%)")


def cmd_logs(args):
    app_id = getattr(args, "app_id", None)
    lines = getattr(args, "lines", 50)
    follow = getattr(args, "follow", False)

    log_dirs = ["/var/log", "/usr/data/openke/logs", "/tmp"]

    # If no app_id is provided, list all discovered log files with sizes
    if not app_id:
        print("Available App & Service Logs:")
        print(f"{'APP/SERVICE':<22} {'SIZE':<10} {'PATH'}")
        print("-" * 75)
        found = False
        seen_paths = set()
        for d in log_dirs:
            if os.path.isdir(d):
                for f in sorted(os.listdir(d)):
                    if f.endswith(".log"):
                        fpath = os.path.join(d, f)
                        if fpath in seen_paths:
                            continue
                        seen_paths.add(fpath)
                        sz = os.path.getsize(fpath)
                        sz_str = f"{sz / 1024:.1f} KB" if sz < 1024*1024 else f"{sz / (1024*1024):.1f} MB"
                        app_name = f[:-4]
                        print(f"{app_name:<22} {sz_str:<10} {fpath}")
                        found = True
        if not found:
            print("No log files found in /var/log or /usr/data/openke/logs.")
        return

    app_id = app_id.lower()
    norm_id = re.sub(r"^[SK]\d+", "", app_id)

    # Candidate paths for app_id
    candidates = [
        f"/var/log/{app_id}.log",
        f"/var/log/{norm_id}.log",
        f"/usr/data/openke/logs/{app_id}.log",
        f"/usr/data/openke/logs/{norm_id}.log",
        f"/tmp/{app_id}.log",
        f"/tmp/{norm_id}.log",
    ]
    if app_id == "vnc":
        candidates.insert(0, "/var/log/vnc.log")
        candidates.insert(1, "/var/log/openke-vnc.log")
    elif app_id == "klipper":
        candidates.insert(0, "/var/log/klipper.log")
        candidates.insert(1, "/tmp/klipper.log")
    elif app_id == "moonraker":
        candidates.insert(0, "/var/log/moonraker.log")
        candidates.insert(1, "/tmp/moonraker.log")
    elif app_id in ("guppy", "guppyscreen"):
        candidates.insert(0, "/var/log/guppyscreen.log")
        candidates.insert(1, "/tmp/guppyscreen.log")

    log_file = None
    for cand in candidates:
        if os.path.isfile(cand):
            log_file = cand
            break

    if not log_file:
        print(f"ERROR: No log file found for app '{app_id}'.", file=sys.stderr)
        print("Checked paths:", file=sys.stderr)
        for c in candidates:
            print(f"  - {c}", file=sys.stderr)
        sys.exit(1)

    if follow:
        try:
            # Use native tail if available
            os.execvp("tail", ["tail", "-n", str(lines), "-f", log_file])
        except Exception:
            # Fallback in Python
            try:
                with open(log_file, "r", encoding="utf-8", errors="replace") as f:
                    all_lines = f.readlines()
                    for l in all_lines[-lines:]:
                        sys.stdout.write(l)
                    sys.stdout.flush()
                    while True:
                        line = f.readline()
                        if line:
                            sys.stdout.write(line)
                            sys.stdout.flush()
                        else:
                            time.sleep(0.5)
            except KeyboardInterrupt:
                pass
    else:
        try:
            with open(log_file, "r", encoding="utf-8", errors="replace") as f:
                all_lines = f.readlines()
                for l in all_lines[-lines:]:
                    sys.stdout.write(l)
                sys.stdout.flush()
        except Exception as e:
            print(f"ERROR: Failed reading {log_file}: {e}", file=sys.stderr)
            sys.exit(1)


def cmd_status(args):
    active_web = get_active_web_ui()
    active_touch = get_active_touch_ui()
    catalog = load_catalog()
    apps = catalog.get("apps", [])

    installed_count = sum(1 for a in apps if is_app_installed(a))
    updates_count = sum(1 for a in apps if is_app_installed(a) and not a.get("is_builtin", False) and get_installed_version(a) and a.get("version") and get_installed_version(a) != a.get("version"))

    stats_map = get_apps_resource_usage(apps, sample_cpu=True, sample_interval=0.1)
    running_count = sum(1 for a in apps if stats_map.get(a.get("id", ""), {}).get("is_running", False))
    total_rss_kb = sum(stats_map.get(a.get("id", ""), {}).get("ram_bytes", 0) // 1024 for a in apps)
    mem_total_kb = get_system_total_memory_kb()

    print("OpenKE App Store Status:")
    print(f"  Active Web UI:       {active_web}")
    print(f"  Active Touch UI:     {active_touch}")
    print(f"  Installed Apps:      {installed_count} / {len(apps)}")
    print(f"  Running App Procs:   {running_count}")
    if mem_total_kb > 0:
        total_pct = round(100.0 * total_rss_kb / mem_total_kb, 1)
        print(f"  App Memory Usage:    {format_bytes(total_rss_kb * 1024)} / {format_bytes(mem_total_kb * 1024)} ({total_pct}%)")
    print(f"  Updates Available:   {updates_count}")
    print(f"  Apps Directory:      {APPS_DIR}")


def cmd_sync(args=None):
    """
    Reconciles all installed apps, metadata, service runners, and Moonraker components.
    Ensures installed apps persist and function seamlessly across SWUpdates and system reboots.
    """
    catalog = load_catalog()
    apps = catalog.get("apps", [])
    os.makedirs(INSTALLED_DIR, exist_ok=True)
    os.makedirs(APPS_DIR, exist_ok=True)
    os.makedirs(SERVICES_DIR, exist_ok=True)

    reconciled = 0
    for app in apps:
        app_id = app.get("id", "")
        if not app_id or app.get("is_builtin", False):
            continue

        if is_app_installed(app):
            install_path = get_install_path(app)

            # Ensure installed metadata exists
            meta = get_installed_app_meta(app_id)
            if not meta:
                save_installed_app_meta(app)

            # Ensure Moonraker components, configurations, macros, and output directories are synchronized
            if app.get("moonraker_component") and os.path.isdir(install_path):
                install_app_moonraker_components(install_path, app)
            if app.get("config_target") and os.path.isdir(install_path):
                install_app_config_files(install_path, app)
            if app.get("output_dirs"):
                install_app_output_dirs(app)
            if app.get("moonraker_config") and os.path.isdir(install_path):
                install_app_moonraker_conf(install_path, app)
            if app.get("klipper_include") and os.path.isdir(install_path):
                install_app_printer_cfg(install_path, app)

            # Ensure service runner exists and is executable
            if (app.get("service") or app.get("service_init")) and os.path.isdir(install_path):
                svc_script = find_app_service_script(app_id)
                if not svc_script:
                    install_app_service(install_path, app)
                else:
                    try:
                        os.chmod(svc_script, 0o755)
                    except Exception:
                        pass

            reconciled += 1

    # Synchronize active web root
    active_web = get_active_web_ui()
    if active_web == "mainsail":
        if os.path.isdir("/usr/share/mainsail"):
            try:
                if os.path.islink(WEB_ROOT_SYMLINK) or os.path.exists(WEB_ROOT_SYMLINK):
                    os.remove(WEB_ROOT_SYMLINK)
                os.symlink("/usr/share/mainsail", WEB_ROOT_SYMLINK)
            except Exception:
                pass
    else:
        active_path = os.path.join(APPS_DIR, active_web)
        if os.path.isdir(active_path):
            try:
                if os.path.islink(WEB_ROOT_SYMLINK) or os.path.exists(WEB_ROOT_SYMLINK):
                    os.remove(WEB_ROOT_SYMLINK)
                os.symlink(active_path, WEB_ROOT_SYMLINK)
            except Exception:
                pass

    if getattr(args, "json", False) if args else False:
        print(json.dumps({"status": "ok", "reconciled_apps": reconciled}, indent=2))
    else:
        print(f"OK: Reconciled {reconciled} installed apps across persistent storage.")


def main():
    parser = argparse.ArgumentParser(description="OpenKE App Store Package & Service Manager")
    subparsers = parser.add_subparsers(dest="command", help="Command to execute")

    # list
    p_list = subparsers.add_parser("list", help="List available and installed apps")
    p_list.add_argument("--json", action="store_true", help="Output JSON format")
    p_list.add_argument("--category", help="Filter by category (web_ui, touch_ui, plugin, tool)")
    p_list.set_defaults(func=cmd_list)

    # top / stats / ps
    p_top = subparsers.add_parser("top", help="Display live RAM and CPU resource usage for active apps")
    p_top.add_argument("--json", action="store_true", help="Output JSON format")
    p_top.add_argument("--all", "-a", action="store_true", help="Show all installed apps even if stopped")
    p_top.set_defaults(func=cmd_top)

    p_stats = subparsers.add_parser("stats", help="Alias for top")
    p_stats.add_argument("--json", action="store_true", help="Output JSON format")
    p_stats.add_argument("--all", "-a", action="store_true", help="Show all installed apps even if stopped")
    p_stats.set_defaults(func=cmd_top)

    p_ps = subparsers.add_parser("ps", help="Alias for top")
    p_ps.add_argument("--json", action="store_true", help="Output JSON format")
    p_ps.add_argument("--all", "-a", action="store_true", help="Show all installed apps even if stopped")
    p_ps.set_defaults(func=cmd_top)

    # logs / log
    p_logs = subparsers.add_parser("logs", help="View output and error logs for an app service")
    p_logs.add_argument("app_id", nargs="?", help="App ID to view logs for (lists all logs if omitted)")
    p_logs.add_argument("-f", "--follow", action="store_true", help="Follow log output in real time")
    p_logs.add_argument("-n", "--lines", type=int, default=50, help="Number of trailing log lines to display (default: 50)")
    p_logs.set_defaults(func=cmd_logs)

    p_log = subparsers.add_parser("log", help="Alias for logs")
    p_log.add_argument("app_id", nargs="?", help="App ID to view logs for (lists all logs if omitted)")
    p_log.add_argument("-f", "--follow", action="store_true", help="Follow log output in real time")
    p_log.add_argument("-n", "--lines", type=int, default=50, help="Number of trailing log lines to display (default: 50)")
    p_log.set_defaults(func=cmd_logs)

    # update
    p_upd = subparsers.add_parser("update", help="Update catalog from remote AppStore repository")
    p_upd.add_argument("--url", help="Override catalog URL")
    p_upd.set_defaults(func=cmd_update)

    # sync / reconcile / boot-sync
    p_sync = subparsers.add_parser("sync", help="Reconcile and verify installed apps and services across SWUpdates")
    p_sync.add_argument("--json", action="store_true", help="Output JSON format")
    p_sync.set_defaults(func=cmd_sync)

    p_rec = subparsers.add_parser("reconcile", help="Alias for sync")
    p_rec.add_argument("--json", action="store_true", help="Output JSON format")
    p_rec.set_defaults(func=cmd_sync)

    p_bsync = subparsers.add_parser("boot-sync", help="Alias for sync")
    p_bsync.add_argument("--json", action="store_true", help="Output JSON format")
    p_bsync.set_defaults(func=cmd_sync)

    # install
    p_inst = subparsers.add_parser("install", help="Download and install an app")
    p_inst.add_argument("app_id", help="App ID to install")
    p_inst.add_argument("--activate", action="store_true", help="Automatically activate the app after install")
    p_inst.add_argument("--force", action="store_true", help="Bypass print and thermal safety checks if activating")
    p_inst.set_defaults(func=cmd_install)

    # upgrade
    p_upg = subparsers.add_parser("upgrade", help="Upgrade installed app(s) to latest catalog version")
    p_upg.add_argument("app_id", nargs="?", default="all", help="App ID to upgrade (or 'all')")
    p_upg.add_argument("--all", action="store_true", help="Upgrade all installed apps")
    p_upg.add_argument("--force", action="store_true", help="Bypass print and thermal safety checks")
    p_upg.set_defaults(func=cmd_upgrade)

    # remove
    p_rm = subparsers.add_parser("remove", help="Uninstall and remove an app")
    p_rm.add_argument("app_id", help="App ID to remove")
    p_rm.add_argument("--force", action="store_true", help="Bypass print and thermal safety checks if reverting active UI")
    p_rm.set_defaults(func=cmd_remove)

    # set-active-web
    p_saw = subparsers.add_parser("set-active-web", help="Switch default Web Interface (mainsail/fluidd)")
    p_saw.add_argument("app_id", help="Target Web UI (e.g. mainsail, fluidd)")
    p_saw.add_argument("--force", action="store_true", help="Bypass print safety check")
    p_saw.set_defaults(func=cmd_set_active_web)

    # set-active-touch
    p_sat = subparsers.add_parser("set-active-touch", help="Switch default Touchscreen UI (guppyscreen/helixscreen)")
    p_sat.add_argument("app_id", help="Target Touch UI (e.g. guppyscreen, helixscreen)")
    p_sat.add_argument("--force", action="store_true", help="Bypass print and thermal safety checks")
    p_sat.set_defaults(func=cmd_set_active_touch)

    # status
    p_stat = subparsers.add_parser("status", help="Show system app status")
    p_stat.set_defaults(func=cmd_status)

    # service
    p_svc = subparsers.add_parser("service", help="Manage dynamic background app services")
    p_svc.add_argument("action", choices=["start", "stop", "restart", "status", "enable", "disable", "is-enabled", "list"], help="Service action (start, stop, restart, status, enable, disable, is-enabled, list)")
    p_svc.add_argument("app_id", nargs="?", help="App ID for service action")
    p_svc.set_defaults(func=cmd_service)

    args = parser.parse_args()
    if not hasattr(args, "func"):
        parser.print_help()
        sys.exit(1)

    args.func(args)


if __name__ == "__main__":
    main()


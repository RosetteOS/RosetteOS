+def connect_sqlite_nolock(
+    db_path: pathlib.Path, timeout: float = 5.
+) -> sqlite3.Connection:
+    # RosetteOS (Ender 3 V3 KE / Nebula Pad, Ingenic X2000, Linux 6.6.18-rt23):
+    # plain sqlite3.connect() against this database path hits
+    # "sqlite3.OperationalError: database is locked" (or hangs outright) on
+    # every single boot, even with a single connection and zero real
+    # contention. strace on the real hardware isolates it to one syscall:
+    # fcntl64(fd, F_SETLK64, {l_type=F_RDLCK, l_start=1073741824, l_len=1})
+    # = -1 EACCES - SQLite's own PENDING_BYTE locking-protocol offset,
+    # rejected by this kernel's tmpfs POSIX advisory locking with no other
+    # process holding anything. Reproduced consistently, and consistently
+    # fixed, by opening the connection with the "nolock=1" URI parameter,
+    # SQLite's own documented workaround for filesystems that do not
+    # support POSIX locking correctly (see sqlite.org's URI filename docs).
+    # Safe here specifically because this database is private to a single
+    # Moonraker process on a private tmpfs mount - there is no real
+    # multi-process contention for nolock to be unsafely skipping.
+    from urllib.parse import quote
+    uri = f"file:{quote(str(db_path))}?nolock=1"
+    return sqlite3.connect(
+        uri, uri=True, timeout=timeout, detect_types=sqlite3.PARSE_DECLTYPES
+    )
+

# NebulaOS mutable-runtime mission, Memory Resilience Gate (2026-07-26):
# real bug found live on the actual device - `swapon -p 100 /dev/zram0`
# failed outright ("swapon: invalid option -- 'p'"), and the documented
# BusyBox workaround (an /etc/fstab entry with a "pri=" mount option,
# activated via `swapon -a`) DID bring the swap area up but silently
# ignored the requested priority (confirmed live: /proc/swaps showed
# priority -2, not the requested 100) - because
# CONFIG_FEATURE_SWAPON_PRI was not enabled in this project's BusyBox
# build at all (confirmed directly against
# vendor/buildroot-x2000/package/busybox/busybox.config, not guessed).
# Without this, there is no way to make the NebulaOS disk swap file
# genuinely lower-priority than zram, which this whole memory-resilience
# design depends on.
CONFIG_FEATURE_SWAPON_PRI=y

# NebulaOS mutable-runtime mission, Phase 7 live-HTTPS qualification
# (2026-07-26): two more real gaps found live, both blocking real HTTPS
# to GitHub entirely (not just during the early-boot pre-NTP window this
# project already knew about) - confirmed directly, not guessed:
# - No NTP client existed anywhere on this image at all (`which ntpd
#   chronyd sntp` all empty) - the clock was permanently stuck at its
#   post-reset default (confirmed live: `date -u` read "Sun Mar 1 2020"
#   on a device that had been running for hours), not just briefly wrong
#   at boot. `git`/curl/wget HTTPS all failed with "certificate is not
#   yet valid" as a direct, permanent consequence.
# - BusyBox's own `wget` had no HTTPS support compiled in at all
#   (confirmed: `wget --help` shows only "HTTP or FTP", and a real
#   https:// URL was rejected outright with "not an http or ftp url") -
#   a separate gap from the clock issue, would have blocked
#   `wget --spider https://github.com/` even with a correct clock.
CONFIG_NTPD=y
CONFIG_FEATURE_WGET_HTTPS=y

# NebulaOS mutable-runtime mission, Phase 7 live qualification (2026-07-26):
# another real gap found live - Moonraker's machine.py component polls
# network interfaces via `ip -json -det address` every ~10s to serve
# its own /machine/* API and Mainsail's network status page. BusyBox's
# `ip` applet has no -json/-j or -d/-det support at all (confirmed live:
# both forms just print busybox's own usage text) - a structural
# limitation of the minimal reimplementation, not a missing flag to
# enable. This was spamming moonraker.log with a ShellCommandError
# traceback every ~10s indefinitely.
#
# Fixed by building the real net-tools/iproute2 package (BR2_PACKAGE_IPROUTE2,
# see buildroot.config) instead of trying to patch BusyBox's applet.
# Buildroot's own busybox.mk uses the upstream `install-noclobber` install
# rule (confirmed against package/busybox/busybox.mk and busybox's own
# applets/install.sh), meaning whichever of busybox/iproute2 happens to
# install its /sbin/ip first during TARGET_FINALIZE silently wins - not
# something to leave to build-order luck. Disabling BusyBox's own ip
# applet entirely removes the ambiguity: only iproute2's real, JSON-capable
# `ip` binary can ever occupy /sbin/ip.
CONFIG_IP=n
